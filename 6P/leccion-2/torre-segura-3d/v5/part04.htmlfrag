ilter((_,i)=>i%5===0||i%11===0).forEach(m=>m.isVisible=false);} } else {const severe=Math.max(0,(ratio-.14)/.86); if(collapse>0){root.rotation.z=-0.14-collapse*.68; root.rotation.y=.12*collapse; root.position.x=4.1*collapse; root.position.y=-1.35*collapse;} else {root.rotation.z=-0.06*severe; root.rotation.y=0; root.position.x=.4*severe; root.position.y=0;} refs.crack1.isVisible=ratio>.16; refs.crack2.isVisible=ratio>.26; refs.voidHole.isVisible=ratio>.52; refs.debris2.forEach(m=>m.isVisible=ratio>.3); refs.debris3.forEach(m=>m.isVisible=ratio>.56); refs.ruin.forEach(m=>m.isVisible=collapse>.32 || state.previewMode==='destroyed'); if(ratio>.28&&!refs.stage2){refs.stage2=true;refs.modules.filter((_,i)=>i%6===0||i%10===0).forEach(m=>m.isVisible=false);} if(ratio>.54&&!refs.stage3){refs.stage3=true;refs.modules.filter((_,i)=>i%4===0||i%13===0).forEach(m=>m.isVisible=false);} }
  const fireOn = state.burning || ratio>.45 || state.previewMode==='destroyed'; refs.fires.forEach((n,i)=>{const on=fireOn&&(i<1||ratio>.34)&&(i<2||ratio>.5)&&(i<3||ratio>.66); n.fire.isVisible=on; n.glow.isVisible=on; if(on){const s=1+.18*Math.sin(time*9+i*1.6); n.fire.scaling.set(s*.9,1.1+s*.35,s*.9); n.fire.rotation.z=Math.sin(time*5+i)*.08; n.glow.scaling.setAll(1+.28*Math.sin(time*6+i));}}); refs.smokes.forEach((n,i)=>{const on=fireOn&&(i<1||ratio>.34)&&(i<2||ratio>.5)&&(i<3||ratio>.66); n.mesh.isVisible=on; if(on){n.mesh.position.y = n.baseY + (Math.sin(time*1.2+i)+1)*.18 + ((time*0.55+i*.1)%1.6); n.mesh.scaling.setAll(1+.14*Math.sin(time*2+i));}}); }
function getDoorPosition(){return currentBuilding && currentBuilding.doorFn ? currentBuilding.doorFn() : new B.Vector3(0,.2,1);}
function resetBuildingVisualState(){if(!currentBuilding)return;resetMotionState();const refs=currentBuilding.refs;refs.modules.forEach(m=>m.isVisible=true);refs.stage2=false;refs.stage3=false;refs.debris2.forEach(m=>m.isVisible=false);refs.debris3.forEach(m=>m.isVisible=false);if(refs.ruin)refs.ruin.forEach(m=>m.isVisible=false);refs.crack1.isVisible=false;refs.crack2.isVisible=false;refs.voidHole.isVisible=false;refs.fires.forEach(n=>{n.fire.isVisible=false;n.glow.isVisible=false;});refs.smokes.forEach(n=>n.mesh.isVisible=false);currentBuilding.root.position.x=0;currentBuilding.root.position.y=0;currentBuilding.root.position.z=currentBuilding.type==='corner'?-1.7:-2.3;currentBuilding.root.rotation.set(0,0,0);currentBuilding.root.scaling.set(1,1,1);if(currentBuilding.type==='tower'){refs.upper.position.set(0,13.8,0);refs.upper.rotation.set(0,0,0);refs.upper.scaling.set(1,1,1);refs.lower.position.set(0,4.9,0);refs.lower.rotation.set(0,0,0);}}
function destroyPreview(){state.previewMode='destroyed'; state.burning=true; resetBuildingVisualState();spawnCinematicFx(1.2,true); applyDamageVisual(1,1); camera.setTarget(new B.Vector3(currentBuilding.type==='corner'?1.2:2.6,3.2,1.2)); camera.radius=30; showInspector('building','active'); $('collapseBadge').classList.add('on'); showWarning('VISTA DE RUINA','Gira y acerca la cámara para inspeccionar el edificio destruido.');}
function restorePreview(){state.previewMode='intact';state.burning=false;collapseProgress=0;resetBuildingVisualState();rebuildMissionStats(false);resetBuildingVisualState();applyDamageVisual(0,0);$('collapseBadge').classList.remove('on');camera.setTarget(new B.Vector3(currentBuilding.type==='corner'?-1.8:0,6.5,1));camera.radius=33;showInspector('building','active');showWarning('Vista intacta restaurada','Listo para jugar de nuevo.');}
function rebuildMissionStats(resetCredits=true){const occ=parseInt($('occupancyRange').value,10); state.peopleTotal=occ; state.inside=occ; state.evacuating=0; state.evacuated=0; state.trapped=0; state.hp=100; state.lastDamage=0; state.waveIndex=0; state.phase='build'; state.gameOver=false; state.paused=false; state.burning=false; waveRuntime=null; activePulses.forEach(p=>p.mesh.dispose()); activePulses=[]; movingPeople.forEach(p=>p.mesh.dispose()); movingPeople=[]; evacuationActive=false; evacAccumulator=0; collapseProgress=0; if(resetCredits) state.credits=420; setPhase('PREPARACIÓN'); state.previewMode='intact';state.animationMode=$('animationMode')?$('animationMode').value:'performance'; $('collapseBadge').classList.remove('on'); defenses.forEach(d=>{d.root.getChildMeshes().forEach(m=>m.dispose()); d.root.dispose();}); defenses.clear(); occupancyMap.clear(); padMeshes.forEach((m,id)=>m.material=mats.pad); resetBuildingVisualState(); showInspector('building','active'); updateHud(); applyDamageVisual(0,0); }
function updateHud(){ $('hpValue').textContent=Math.max(0,Math.round(state.hp)); $('hpBar').style.transform=`scaleX(${Math.max(0,state.hp)/state.maxHp})`; $('credits').textContent=Math.floor(state.credits); $('waveValue').textContent=`${Math.min(state.waveIndex+1,4)} / 4`; $('evacValue').textContent=`${state.evacuated} / ${state.peopleTotal}`; $('movingValue').textContent=state.evacuating; $('trappedValue').textContent=state.trapped; $('intensityOut').value=$('intensityRange').value; $('occupancyOut').value=$('occupancyRange').value; $('alarmBadge').classList.toggle('on',evacuationActive && alarmCount()>0); $('fireBadge').classList.toggle('on',state.burning);if(state.gameOver&&state.hp<=0)$('collapseBadge').classList.add('on'); $('quickStart').classList.toggle('hidden',state.phase!=='build' || state.gameOver || state.previewMode==='destroyed'); $('repairBtn').classList.toggle('hidden',!(state.phase==='build' && state.hp<100 && state.hp>0 && state.credits>=28)); document.querySelectorAll('.buildBtn').forEach(btn=>{btn.disabled=!(state.phase==='build' && state.previewMode==='intact' && state.credits>=cost[btn.dataset.build]);}); }
function showInspector(kind,id){selected={kind,id}; $('sellBtn').classList.add('hidden'); if(kind==='building'){ $('name').textContent=currentBuilding?currentBuilding.name:'Edificio'; $('desc').textContent=currentBuilding?currentBuilding.desc:'Edificio activo'; $('stats').innerHTML=`<div class="stat"><span>Integridad</span><span>${Math.max(0,Math.round(state.hp))} / 100</span></div><div class="stat"><span>Estado</span><span>${damageState()}</span></div><div class="stat"><span>Aisladores</span><span>${totalDefense('isolator')} · ${Math.round(isoReduction()*100)}% protección</span></div><div class="stat"><span>Alarmas</span><span>${alarmCount()}</span></div><div class="stat"><span>Suelo</span><span>${$('soilSelect').selectedOptions[0].textContent}</span></div><div class="stat"><span>Condición</span><span>${$('conditionSelect').selectedOptions[0].textContent}</span></div><div class="stat"><span>Personas</span><span>Dentro ${state.inside} · En salida ${state.evacuating}</span></div><div class="stat"><span>Evacuados / atrapados</span><span>${state.evacuated} / ${state.trapped}</span></div><div class="stat"><span>Último impacto</span><span>${Math.round(state.lastDamage)}</span></div>`; } else { const d=defenses.get(id); if(!d) return; $('name').textContent=d.type==='isolator'?'Aislador sísmico':'Alarma de evacuación'; $('desc').textContent=d.type==='isolator'?'Reduce parte del daño total de la estructura.' :'Activa la evacuación antes del primer impacto y aumenta el flujo de salida.'; $('stats').innerHTML=`<div class="stat"><span>Tipo</span><span>${d.type==='isolator'?'Protección estructural':'Seguridad y evacuación'}</span></div><div class="stat"><span>Efecto</span><span>${d.type==='isolator'?'−18% daño':'Salida anticipada +'}</span></div><div class="stat"><span>Pad</span><span>${d.padId.toUpperCase()}</span></div><div class="stat"><span>Venta</span><span>${Math.floor(cost[d.type]*sellRate)} CE</span></div>`; $('sellBtn').classList.remove('hidden'); $('sellBtn').textContent=`Vender · +${Math.floor(cost[d.type]*sellRate)} CE`; }
}
function highlight(root,color='#7fe1d3'){scene.meshes.forEach(m=>{if(m.renderOutline)m.renderOutline=false;}); if(!root) return; root.getChildMeshes().forEach(m=>{m.renderOutline=true; m.outlineColor=B.Color3.FromHexString(color); m.outlineWidth=.06;});}
const ghostRoot=new B.TransformNode('ghost',scene); ghostRoot.setEnabled(false);
function setBuild(type){buildType=type;scene.skipPointerMovePicking=!type; document.querySelectorAll('.buildBtn').forEach(btn=>btn.style.borderColor=(btn.dataset.build===type)?'#7fe1d38a':'#ffffff20'); ghostRoot.setEnabled(false); padMeshes.forEach((m,id)=>{m.material = !type ? (occupancyMap.has(id)?mats.padOcc:mats.pad) : occupancyMap.has(id)?mats.padOcc:(state.credits>=cost[type]?mats.padActive:mats.pad);}); }
function makeGhost(type){ghostRoot.getChildMeshes().forEach(m=>m.dispose()); if(type==='isolator'){const tor=B.MeshBuilder.CreateTorus('gIso',{diameter:1.7,thickness:.28,tessellation:44},scene); tor.parent=ghostRoot; tor.rotation.x=Math.PI/2; tor.material=mats.isolatorGlow; const cen=B.MeshBuilder.CreateCylinder('gIso2',{diameter:.56,height:.42},scene); cen.parent=ghostRoot; cen.position.y=.18; cen.material=mats.isolator;} else if(type==='alarm'){const pole=B.MeshBuilder.CreateCylinder('gAl',{height:2.8,diameter:.18},scene); pole.parent=ghostRoot; pole.position.y=1.4; pole.material=mats.alarm; const beacon=B.MeshBuilder.CreateSphere('gAl2',{diameter:.48,segments:10},scene); beacon.parent=ghostRoot; beacon.position.y=2.85; beacon.material=mats.alarmGlow; const ring=B.MeshBuilder.CreateTorus('gAl3',{diameter:1.25,thickness:.05,tessellation:32},scene); ring.parent=ghostRoot; ring.rotation.x=Math.PI/2; ring.position.y=2.75; ring.material=mats.alarmGlow; }}
function createDefense(type,padId,padPos){const root=new B.TransformNode('def'+defenseNo,scene); root.position.set(padPos.x,.12,padPos.z); if(type==='isolator'){const tor=B.MeshBuilder.CreateTorus('tor'+defenseNo,{diameter:1.7,thickness:.28,tessellation:44},scene); tor.parent=root; tor.rotation.x=Math.PI/2; tor.material=mats.isolator; const cyl=B.MeshBuilder.CreateCylinder('cyl'+defenseNo,{diameter:.56,height:.42},scene); cyl.parent=root; cyl.position.y=.18; cyl.material=mats.isolator; const glow=B.MeshBuilder.CreateTorus('gl'+defenseNo,{diameter:2.1,thickness:.07,tessellation:52},scene); glow.parent=root; glow.rotation.x=Math.PI/2; glow.position.y=.02; glow.material=mats.isolatorGlow;} else {const pole=B.MeshBuilder.CreateCylinder('p'+defenseNo,{height:2.9,diameter:.16},scene); pole.parent=root; pole.position.y=1.45; pole.material=mats.alarm; const base=B.MeshBuilder.CreateCylinder('pb'+defenseNo,{diameter:.58,height:.28},scene); base.parent=root; base.position.y=.14; base.material=mats.alarm; const beacon=B.MeshBuilder.CreateSphere('be'+defenseNo,{diameter:.46,segments:10},scene); beacon.parent=root; beacon.position.y=2.92; beacon.material=mats.alarm; const ring=B.MeshBuilder.CreateTorus('ri'+defenseNo,{diameter:1.1,thickness:.05,tessellation:36},scene); ring.parent=root; ring.rotation.x=Math.PI/2; ring.position.y=2.82; ring.material=mats.alarmGlow; ring.isVisible=false; root.alarmBeacon=beacon; root.alarmRing=ring; }
  root.getChildMeshes().forEach(m=>{m.metadata={pickKind:'defense',id:'d'+defenseNo}; m.isPickable=true;}); const d={id:'d'+defenseNo++,type,padId,root}; defenses.set(d.id,d); occupancyMap.set(padId,d.id); padMeshes.get(padId).material=mats.padOcc; return d; }
function sellSelected(){if(!selected || selected.kind!=='defense' || state.phase!=='build') return; const d=defenses.get(selected.id); if(!d) return; state.credits+=Math.floor(cost[d.type]*sellRate);state.uiDirty=true; occupancyMap.delete(d.padId); d.root.getChildMeshes().forEach(m=>m.dispose()); d.root.dispose(); defenses.delete(d.id); highlight(currentBuilding.root); showInspector('building','active'); setBuild(null); toast('Defensa vendida.','good'); updateHud();}
function repair(){if(state.phase!=='build' || state.hp<=0 || state.hp>=100 || state.credits<28) return; state.credits-=28;state.hp=Math.min(100,state.hp+10);state.uiDirty=true; toast('Reparación aplicada.','good'); showInspector('building','active'); updateHud();}
function generateWave(level,index){const baseCount=2+index+(level>=10?1:0)+(level>=14?1:0); const duration=18+index*8+Math.max(0,level-10); const events=[]; for(let i=0;i<baseCount;i++){const at=1 + i*((duration-4)/Math.max(1,baseCount-1)); const type=i%3===0?'fast':i%3===1?'strong':'surface'; const intensity=Math.min(.96,.18 + (level-5)*.045 + index*.08 + (type==='surface'?.06:type==='strong'?.03:0)); events.push({at,type,intensity}); } return {duration,reward:90+index*38+Math.round(level*4),events}; }
function startWave(){if(state.phase!=='build'||state.previewMode==='destroyed')return;if(state.musicStarted&&state.music&&state.music.ctx.state==='suspended'){state.music.ctx.resume().catch(()=>{});}setBuild(null); state.phase='warning'; setPhase('ALERTA'); const countdown=5; let left=countdown; evacuationActive=alarmCount()>0; showWarning(alarmCount()>0?'ALARMA ACTIVADA: la evacuación empezó antes del impacto.':'Sin alarma: la evacuación arrancará tarde.', 'Intensidad actual: '+state.intensityLevel); updateHud(); const timer=setInterval(()=>{if(state.paused || state.gameOver) return; left--; $('warningText').textContent=`Oleada ${state.waveIndex+1} en ${left} s`; if(left<=0){clearInterval(timer); state.phase='wave'; setPhase('EVENTO EN CURSO'); if(alarmCount()===0) evacuationActive=true; waveRuntime={elapsed:0,triggered:new Set(),wave:generateWave(state.intensityLevel,state.waveIndex)}; toast('Comenzó la oleada.','warn'); updateHud();}},1000); }
function spawnPulse(def){const ring=B.MeshBuilder.CreateTorus('pulse',{diameter:2,thickness:.22,tessellation:48},scene); ring.position.set(epicenter.x,.18,epicenter.z); ring.rotation.x=Math.PI/2; ring.material=pulseMat(def.type); ring.isPickable=false; activePulses.push({mesh:ring,radius:1,speed:def.type==='fast'?7.2:def.type==='strong'?4.8:3.9,intensity:def.intensity,type:def.type,hit:false,dead:false}); showWarning(`${pulseLabel(def.type)} · ${Math.round(def.intensity*100)}%`, 'Suelo, condición e intensidad definen e
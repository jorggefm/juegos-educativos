l destino del edificio.'); }
function applyDamage(p){const levelFactor=.76 + state.intensityLevel*.135; const raw=p.intensity*(9+state.intensityLevel*1.55)*levelFactor*state.soilFactor*state.conditionFactor*(currentBuilding?currentBuilding.fragility:1); let damage=raw*(1-isoReduction()); if(p.type==='surface') damage*=1.12; if(state.waveIndex>=2) damage*=1.08; if(state.waveIndex===3) damage*=1.12; state.lastDamage=damage;state.hp=Math.max(0,state.hp-damage);state.uiDirty=true;triggerImpact(p.intensity,damage); if(damage>7 || state.hp<62) state.burning=true; if(state.inside>0){const trappedNow=Math.min(state.inside,Math.max(0,Math.floor((damage/100)*state.inside*0.34 + (state.hp<35?2:0)))); if(trappedNow>0){state.inside-=trappedNow; state.trapped+=trappedNow; state.burning=true; toast(`Impacto severo: ${trappedNow} personas quedaron atrapadas.`, 'bad');}}
}
function updatePulses(dt){const target=currentBuilding?currentBuilding.root.position:{x:0,z:0}; const dx=epicenter.x-target.x,dz=epicenter.z-target.z; const dist=Math.sqrt(dx*dx+dz*dz); const maxR=58; activePulses.forEach(p=>{if(p.dead)return; p.radius += p.speed*dt; p.mesh.scaling.setAll(p.radius); p.mesh.position.y=.15+Math.sin(time*4)*.02; if(!p.hit && p.radius>=dist){p.hit=true; applyDamage(p); showInspector('building','active'); updateHud();} if(p.radius>maxR){p.dead=true; p.mesh.dispose();}}); activePulses=activePulses.filter(p=>!p.dead); }
const MAX_VISIBLE_PEOPLE=18;function spawnPerson(){if(state.inside<=0)return;state.inside--;if(movingPeople.length>=MAX_VISIBLE_PEOPLE){state.evacuated++;state.uiDirty=true;return;}state.evacuating++;const start=getDoorPosition();const end=new B.Vector3(-11,.18,6);const person=B.MeshBuilder.CreateBox('person',{width:.28,height:.65,depth:.24},scene);person.position.copyFrom(start);person.material=[mats.personA,mats.personB,mats.personC][(state.evacuated+state.evacuating)%3];person.isPickable=false;movingPeople.push({mesh:person,start,end,t:0,duration:3.8+Math.random()*.7});}
function updatePeople(dt){for(let i=movingPeople.length-1;i>=0;i--){const p=movingPeople[i]; p.t += dt/p.duration; const tt=Math.min(1,p.t); p.mesh.position=B.Vector3.Lerp(p.start,p.end,tt); p.mesh.position.y=.18+Math.sin(tt*Math.PI)*.18; if(tt>=1){p.mesh.dispose(); movingPeople.splice(i,1); state.evacuating--; state.evacuated++;}}}
function updateEvac(dt){if(!evacuationActive) return; let rate=0; const alarms=alarmCount(); if(state.phase==='warning') rate=alarms>0?2.4*alarms:0; else if(state.phase==='wave') rate=alarms>0?1.75*alarms:.42; evacAccumulator += rate*dt; while(evacAccumulator>=1 && state.inside>0){evacAccumulator -=1; spawnPerson();}}
function updateWave(dt){if(state.phase!=='wave' || !waveRuntime) return; waveRuntime.elapsed += dt; waveRuntime.wave.events.forEach((e,i)=>{if(waveRuntime.elapsed>=e.at && !waveRuntime.triggered.has(i)){waveRuntime.triggered.add(i); spawnPulse(e);}}); if(waveRuntime.elapsed>=waveRuntime.wave.duration && activePulses.length===0){finishWave();}}
function finishWave(){state.phase='build'; setPhase('PREPARACIÓN'); evacuationActive=false; const reward=waveRuntime.wave.reward + Math.max(0,Math.floor(state.evacuated*.35 - state.trapped*.25)); state.credits+=reward;state.uiDirty=true;waveRuntime=null;state.waveIndex++; toast(`Oleada superada: +${reward} CE.`, 'good'); if(state.waveIndex>=4){finishGame(state.hp>0); return;} showWarning(`Oleada superada. Sigue preparándote.`, 'La siguiente oleada será más dura.'); showInspector('building','active'); updateHud();}
function finishGame(win){state.gameOver=true;state.phase='build';evacuationActive=false;if(win){setPhase('MISIÓN CUMPLIDA');showWarning('LA ESTRUCTURA RESISTIÓ',`Integridad final: ${Math.round(state.hp)} · Evacuados: ${state.evacuated}/${state.peopleTotal}`);toast('Misión completada. Puedes seguir inspeccionando el edificio.','good');}else{setPhase('COLAPSO · INSPECCIONA LA RUINA');state.previewMode='destroyed';state.burning=true;collapseProgress=.01;spawnCinematicFx(1.25,true);playImpactSound(1.25,true);$('collapseBadge').classList.add('on');camera.setTarget(new B.Vector3(currentBuilding.type==='corner'?1.2:2.8,3.0,1.2));camera.radius=30;showWarning('COLAPSO ESTRUCTURAL','No aparece ninguna ventana: la escena queda libre para observar la destrucción.');toast(`Colapso. Evacuados ${state.evacuated}/${state.peopleTotal} · Atrapados ${state.trapped}.`,'bad');}showInspector('building','active');updateHud();}
function updateShake(dt){
  if(!currentBuilding)return;
  // Remove the previous procedural offsets so user camera rotation and damage poses remain stable.
  currentBuilding.root.position.x-=lastMotion.rootX;currentBuilding.root.position.z-=lastMotion.rootZ;currentBuilding.root.rotation.z-=lastMotion.rootRot;
  if(currentBuilding.type==='tower'){currentBuilding.refs.lower.rotation.z-=lastMotion.lowerRot;currentBuilding.refs.upper.rotation.z-=lastMotion.upperRot;currentBuilding.refs.upper.position.x-=lastMotion.upperX;}
  camera.alpha-=lastCameraAlphaOffset;camera.beta-=lastCameraBetaOffset;lastCameraAlphaOffset=lastCameraBetaOffset=0;
  const ratio=1-Math.max(0,state.hp)/state.maxHp;
  const quake=state.phase==='wave';
  if(cinematicEnabled()){
    const k=quake?17:25,c=quake?5.2:7.5;swayVelocity+=(-k*sway-c*swayVelocity)*dt;sway+=swayVelocity*dt;cameraKick*=Math.exp(-5.8*dt);
    const periodic=quake?Math.sin(time*(8.5+state.intensityLevel*.35))*(.10+state.intensityLevel*.012):0;
    const response=Math.max(-1.6,Math.min(1.6,sway+periodic));
    const rootX=response*.11,rootZ=Math.sin(time*12.5)*(.015+cameraKick*.025),rootRot=response*.012;
    currentBuilding.root.position.x+=rootX;currentBuilding.root.position.z+=rootZ;currentBuilding.root.rotation.z+=rootRot;
    lastMotion.rootX=rootX;lastMotion.rootZ=rootZ;lastMotion.rootRot=rootRot;
    if(currentBuilding.type==='tower'){
      const lowerRot=response*.012,upperRot=response*(.032+ratio*.018),upperX=response*(.24+ratio*.18);
      currentBuilding.refs.lower.rotation.z+=lowerRot;currentBuilding.refs.upper.rotation.z+=upperRot;currentBuilding.refs.upper.position.x+=upperX;
      lastMotion.lowerRot=lowerRot;lastMotion.upperRot=upperRot;lastMotion.upperX=upperX;
    }
    lastCameraAlphaOffset=Math.sin(time*19.3)*cameraKick*.0045;lastCameraBetaOffset=Math.sin(time*15.7+1.2)*cameraKick*.0028;camera.alpha+=lastCameraAlphaOffset;camera.beta+=lastCameraBetaOffset;
  }else{
    const amp=(quake?.055:.008)*(1+ratio*2.0+(state.intensityLevel-5)*.025);const rootZ=Math.sin(time*17)*amp,rootX=Math.sin(time*14.5)*amp*.06;
    currentBuilding.root.position.z+=rootZ;currentBuilding.root.position.x+=rootX;lastMotion.rootZ=rootZ;lastMotion.rootX=rootX;cameraKick*=Math.exp(-8*dt);
  }
}
function updateAlarms(){const on=(state.phase==='warning'||state.phase==='wave') && alarmCount()>0; defenses.forEach(d=>{if(d.type==='alarm' && d.root.alarmBeacon){const blink=on?(Math.sin(time*9+d.root.uniqueId)>0):false; d.root.alarmBeacon.material=blink?mats.alarmGlow:mats.alarm; d.root.alarmRing.isVisible=on; d.root.alarmRing.scaling.x=d.root.alarmRing.scaling.z=1+(Math.sin(time*5+d.root.uniqueId)+1)*.3;}});}
function startMusic(){if(state.musicStarted)return;const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ctx=new AC();const master=ctx.createGain();master.gain.value=.024;master.connect(ctx.destination);const osc1=ctx.createOscillator(),osc2=ctx.createOscillator(),osc3=ctx.createOscillator(),g1=ctx.createGain(),g2=ctx.createGain(),g3=ctx.createGain();osc1.type='triangle';osc2.type='sine';osc3.type='sine';osc1.frequency.value=55;osc2.frequency.value=82.4;osc3.frequency.value=123.5;g1.gain.value=.42;g2.gain.value=.13;g3.gain.value=.055;osc1.connect(g1);g1.connect(master);osc2.connect(g2);g2.connect(master);osc3.connect(g3);g3.connect(master);osc1.start();osc2.start();osc3.start();state.music={ctx,master,osc1,osc2,osc3};state.musicStarted=true;}
function updateMusic(){if(!state.musicStarted||!state.music)return;const m=state.music;const tension=(1-Math.max(0,state.hp)/state.maxHp)+((state.intensityLevel-5)/10)*.60+(state.phase==='wave'?.42:state.phase==='warning'?.14:0);const now=m.ctx.currentTime;m.master.gain.setTargetAtTime(.016+tension*.020,now,.45);m.osc1.frequency.setTargetAtTime(55*(1+tension*.09),now,.45);m.osc2.frequency.setTargetAtTime(82.4*(1+tension*.14),now,.45);m.osc3.frequency.setTargetAtTime(123.5*(1+tension*.18),now,.45);}
scene.onPointerObservable.add(info=>{const mesh=info.pickInfo?.pickedMesh; if(info.type===B.PointerEventTypes.POINTERMOVE && buildType){const padId=mesh?.metadata?.id; if(mesh?.metadata?.pickKind==='pad' && padId && !occupancyMap.has(padId) && state.phase==='build' && state.credits>=cost[buildType] && state.previewMode==='intact'){const m=padMeshes.get(padId); ghostRoot.position.set(m.position.x,.12,m.position.z); ghostRoot.setEnabled(true);} else ghostRoot.setEnabled(false); return;} if(info.type!==B.PointerEventTypes.POINTERPICK || !mesh) return; const md=mesh.metadata; if(buildType){if(md?.pickKind==='pad' && !occupancyMap.has(md.id) && state.phase==='build' && state.previewMode==='intact'){ if(state.credits<cost[buildType]){toast('No hay créditos suficientes.','bad'); return;} const pad=padMeshes.get(md.id); state.credits-=cost[buildType];state.uiDirty=true; const d=createDefense(buildType,md.id,pad.position); toast(buildType==='isolator'?'Aislador instalado.':'Alarma instalada.','good'); setBuild(null); showInspector('defense',d.id); highlight(d.root,buildType==='alarm'?'#ffabab':'#7fe1d3'); updateHud(); } return; } if(md?.pickKind==='building'){highlight(currentBuilding.root); showInspector('building','active');} else if(md?.pickKind==='defense'){const d=defenses.get(md.id); if(!d)return; highlight(d.root,d.type==='alarm'?'#ffabab':'#7fe1d3'); showInspector('defense',d.id);} });
document.querySelectorAll('.buildBtn').forEach(btn=>btn.addEventListener('click',()=>{makeGhost(btn.dataset.build); setBuild(btn.dataset.build);}));
$('sellBtn').addEventListener('click',sellSelected); $('repairBtn').addEventListener('click',repair); $('quickStart').addEventListener('click',startWave); $('enterBtn').addEventListener('click',async()=>{startMusic();if(state.music&&state.music.ctx.state==='suspended'){try{await state.music.ctx.resume();}catch(e){}}$('startModal').style.display='none';toast('V5 lista. Rendimiento por defecto; puedes activar Cinemático cuando quieras.','good');});  $('applyScene').addEventListener('click',()=>{state.intensityLevel=parseInt($('intensityRange').value,10);state.soilFactor=parseFloat($('soilSelect').value);state.conditionFactor=parseFloat($('conditionSelect').value);state.animationMode=$('animationMode').value;engine.setHardwareScalingLevel(parseFloat($('qualitySelect').value));const selectedBuilding=$('buildingSelect').value;loadBuilding(selectedBuilding);rebuildMissionStats(true);toast('Escenario actualizado en modo optimizado.','good');}); $('resetMission').addEventListener('click',()=>{rebuildMissionStats(true); toast('Misión reiniciada.','good');}); $('previewDestroyed').addEventListener('click',destroyPreview); $('previewIntact').addEventListener('click',restorePreview);
$('buildingSelect').addEventListener('change',()=>{state.intensityLevel=parseInt($('intensityRange').value,10); state.soilFactor=parseFloat($('soilSelect').value); state.conditionFactor=parseFloat($('conditionSelect').value);state.animationMode=$('animationMode').value; loadBuilding($('buildingSelect').value); rebuildMissionStats(true);}); $('intensityRange').addEventListener('input',()=>{$('intensityOut').value=$('intensityRange').value; state.intensityLevel=parseInt($('intensityRange').value,10);}); $('occupancyRange').addEventListener('input',()=>{$('occupancyOut').value=$('occupancyRange').value;}); $('qualitySelect').addEventListener('change',()=>{engine.setHardwareScalingLevel(parseFloat($('qualitySelect').value));toast('Calidad gráfica actualizada.','good');}); $('animationMode').addEventListener('change',()=>{state.animationMode=$('animationMode').value;resetMotionState();toast(state.animationMode==='cinematic'?'Modo Cinemático activado.':'Modo Rendimiento activado.','good');});
window.addEventListener('keydown',e=>{if(e.key==='1'){makeGhost('isolator'); setBuild('isolator');} if(e.key==='2'){makeGhost('alarm'); setBuild('alarm');} if(e.key==='Escape') setBuild(null); if(e.code==='Space'){e.preventDefault(); if(state.gameOver) return; state.paused=!state.paused; setPhase(state.paused?'PAUSA':state.phase==='build'?'PREPARACIÓN':state.phase==='warning'?'ALERTA':'EVENTO EN CURSO');}});
window.addEventListener('resize',()=>engine.resize());
loadBuilding('tower'); rebuildMissionStats(true); updateHud(); highlight(currentBuilding.root); showInspector('building','active');
let last=performance.now(),lastRender=0,lastFx=0,lastUi=0,lastAudio=0;engine.runRenderLoop(()=>{const now=performance.now();if(now-lastRender<33)return;const dt=Math.min(.066,(now-last)/1000);last=now;lastRender=now;if(!state.paused){time+=dt;if(now-lastAudio>500){updateMusic();lastAudio=now;}const fxInterval=cinematicEnabled()?55:95;if(now-lastFx>fxInterval){if(state.gameOver&&state.hp<=0)collapseProgress=Math.min(1,collapseProgress+dt*(cinematicEnabled()?.60:.72));if(state.previewMode==='destroyed'){const c=state.gameOver?Math.max(.78,collapseProgress):1;applyDamageVisual(1,c);}else{const ratio=1-Math.max(0,state.hp)/state.maxHp;applyDamageVisual(ratio,collapseProgress);}updateAlarms();lastFx=now;}updateCinematicFx(dt);if(!state.gameOver){if(state.phase==='warning'||state.phase==='wave')updateEvac(dt);if(state.phase==='wave')updateWave(dt);updatePulses(dt);updatePeople(dt);updateShake(dt);if(state.hp<=0&&!state.gameOver)finishGame(false);}else{updatePeople(dt);if(cinematicEnabled())updateShake(dt);}if(now-lastUi>200||state.uiDirty){updateHud();state.uiDirty=false;lastUi=now;}}scene.render();});
})();
</script>
</body>
</html>
l destino del edificio.'); }
function triggerImpact(strength,damage){
  if(!currentBuilding)return;
  const s=Math.min(1.35,Math.max(.12,strength+damage/52));
  const phase=(waveRuntime?.elapsed||time)*1.73+state.waveIndex*.91;
  const dir=Math.sin(phase)>=0?1:-1;
  // V6: el impacto alimenta la respuesta del suelo, no rota el edificio instantáneamente.
  swayVelocity+=dir*s*1.55;
  cameraKick=Math.max(cameraKick,s*.72);
  if(cinematicEnabled()&&(damage>5.5||s>.72))spawnCinematicFx(Math.min(1,s*.72),false);
  playImpactSound(Math.min(1.05,s*.88),false);
}
function applyDamage(p){const levelFactor=.76 + state.intensityLevel*.135; const raw=p.intensity*(9+state.intensityLevel*1.55)*levelFactor*state.soilFactor*state.conditionFactor*(currentBuilding?currentBuilding.fragility:1); let damage=raw*(1-isoReduction()); if(p.type==='surface') damage*=1.12; if(state.waveIndex>=2) damage*=1.08; if(state.waveIndex===3) damage*=1.12; state.lastDamage=damage;state.hp=Math.max(0,state.hp-damage);state.uiDirty=true;triggerImpact(p.intensity,damage); if(damage>7 || state.hp<62) state.burning=true; if(state.inside>0){const trappedNow=Math.min(state.inside,Math.max(0,Math.floor((damage/100)*state.inside*0.34 + (state.hp<35?2:0)))); if(trappedNow>0){state.inside-=trappedNow; state.trapped+=trappedNow; state.burning=true; toast(`Impacto severo: ${trappedNow} personas quedaron atrapadas.`, 'bad');}}
}
function updatePulses(dt){const target=currentBuilding?currentBuilding.root.position:{x:0,z:0}; const dx=epicenter.x-target.x,dz=epicenter.z-target.z; const dist=Math.sqrt(dx*dx+dz*dz); const maxR=58; activePulses.forEach(p=>{if(p.dead)return; p.radius += p.speed*dt; p.mesh.scaling.setAll(p.radius); p.mesh.position.y=.15+Math.sin(time*4)*.02; if(!p.hit && p.radius>=dist){p.hit=true; applyDamage(p); showInspector('building','active'); updateHud();} if(p.radius>maxR){p.dead=true; p.mesh.dispose();}}); activePulses=activePulses.filter(p=>!p.dead); }
const MAX_VISIBLE_PEOPLE=18;function spawnPerson(){if(state.inside<=0)return;state.inside--;if(movingPeople.length>=MAX_VISIBLE_PEOPLE){state.evacuated++;state.uiDirty=true;return;}state.evacuating++;const start=getDoorPosition();const end=new B.Vector3(-11,.18,6);const person=B.MeshBuilder.CreateBox('person',{width:.28,height:.65,depth:.24},scene);person.position.copyFrom(start);person.material=[mats.personA,mats.personB,mats.personC][(state.evacuated+state.evacuating)%3];person.isPickable=false;movingPeople.push({mesh:person,start,end,t:0,duration:3.8+Math.random()*.7});}
function updatePeople(dt){for(let i=movingPeople.length-1;i>=0;i--){const p=movingPeople[i]; p.t += dt/p.duration; const tt=Math.min(1,p.t); const u=tt*tt*(3-2*tt); p.mesh.position=B.Vector3.Lerp(p.start,p.end,u); p.mesh.position.y=.18+Math.sin(tt*Math.PI)*.18; if(tt>=1){p.mesh.dispose(); movingPeople.splice(i,1); state.evacuating--; state.evacuated++;}}}
function updateEvac(dt){if(!evacuationActive) return; let rate=0; const alarms=alarmCount(); if(state.phase==='warning') rate=alarms>0?2.4*alarms:0; else if(state.phase==='wave') rate=alarms>0?1.75*alarms:.42; evacAccumulator += rate*dt; while(evacAccumulator>=1 && state.inside>0){evacAccumulator -=1; spawnPerson();}}
function updateWave(dt){if(state.phase!=='wave' || !waveRuntime) return; waveRuntime.elapsed += dt; waveRuntime.wave.events.forEach((e,i)=>{if(waveRuntime.elapsed>=e.at && !waveRuntime.triggered.has(i)){waveRuntime.triggered.add(i); spawnPulse(e);}}); if(waveRuntime.elapsed>=waveRuntime.wave.duration && activePulses.length===0){finishWave();}}
function finishWave(){state.phase='build'; setPhase('PREPARACIÓN'); evacuationActive=false; const reward=waveRuntime.wave.reward + Math.max(0,Math.floor(state.evacuated*.35 - state.trapped*.25)); state.credits+=reward;state.uiDirty=true;waveRuntime=null;state.waveIndex++; toast(`Oleada superada: +${reward} CE.`, 'good'); if(state.waveIndex>=4){finishGame(state.hp>0); return;} showWarning(`Oleada superada. Sigue preparándote.`, 'La siguiente oleada será más dura.'); showInspector('building','active'); updateHud();}
let v6CollapseFxFired=false;
function finishGame(win){state.gameOver=true;state.phase='build';evacuationActive=false;if(win){setPhase('MISIÓN CUMPLIDA');showWarning('LA ESTRUCTURA RESISTIÓ',`Integridad final: ${Math.round(state.hp)} · Evacuados: ${state.evacuated}/${state.peopleTotal}`);toast('Misión completada. Puedes seguir inspeccionando el edificio.','good');}else{setPhase('COLAPSO · INSPECCIONA LA RUINA');state.previewMode='destroyed';state.burning=true;collapseProgress=.001;v6CollapseFxFired=false;playImpactSound(1.05,true);$('collapseBadge').classList.add('on');camera.setTarget(new B.Vector3(currentBuilding.type==='corner'?1.2:2.8,3.0,1.2));camera.radius=30;showWarning('FALLA ESTRUCTURAL EN PROGRESO','La deformación y el colapso ocurren de forma progresiva; la ruina queda libre para inspección.');toast(`Colapso. Evacuados ${state.evacuated}/${state.peopleTotal} · Atrapados ${state.trapped}.`,'bad');}showInspector('building','active');updateHud();}

// ─────────────────────────────────────────────────────────────────────────────
// V6 STRUCTURAL RESPONSE
// Seis masas virtuales conectadas por resortes/amortiguadores. La integración
// ocurre a 120 Hz y luego se proyecta sobre los nodos visuales del edificio.
// ─────────────────────────────────────────────────────────────────────────────
const V6_N=6,V6_STEP=1/120;
const v6X=new Float64Array(V6_N),v6VX=new Float64Array(V6_N),v6AX=new Float64Array(V6_N);
const v6Z=new Float64Array(V6_N),v6VZ=new Float64Array(V6_N),v6AZ=new Float64Array(V6_N);
let v6Accumulator=0,v6BuildingKey='',v6GroundX=0,v6GroundZ=0,v6WasQuake=false;
function v6Clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function v6ResetDynamics(){v6X.fill(0);v6VX.fill(0);v6AX.fill(0);v6Z.fill(0);v6VZ.fill(0);v6AZ.fill(0);v6Accumulator=0;v6GroundX=0;v6GroundZ=0;v6WasQuake=false;sway=0;swayVelocity=0;cameraKick=0;lastMotion={rootX:0,rootZ:0,rootRot:0,lowerRot:0,upperRot:0,upperX:0};lastCameraAlphaOffset=lastCameraBetaOffset=0;}
function v6Signal(t,phase=0){
  // Mezcla continua y no repetitiva a simple vista: sin saltos aleatorios frame a frame.
  return .48*Math.sin(t*5.7+phase)+.27*Math.sin(t*8.9+1.17+phase*.7)+.16*Math.sin(t*13.6+2.31-phase*.4)+.09*Math.sin(t*21.2+.44+phase*1.3)+.055*Math.sin(t*2.35+Math.sin(t*.31)*1.8+phase);
}
function v6IntegrateAxis(pos,vel,acc,groundAcc,h,stiff,damp){
  for(let i=0;i<V6_N;i++){
    const p=pos[i],v=vel[i];
    const belowP=i===0?0:pos[i-1],belowV=i===0?0:vel[i-1];
    let force=-stiff*(p-belowP)-damp*(v-belowV);
    if(i<V6_N-1){force+=stiff*(pos[i+1]-p)+damp*(vel[i+1]-v);}
    const mass=1.08-i*.025;
    acc[i]=force/mass-groundAcc*(1+i*.018);
  }
  for(let i=0;i<V6_N;i++){
    vel[i]+=acc[i]*h;
    vel[i]*=.9992;
    pos[i]+=vel[i]*h;
    pos[i]=v6Clamp(pos[i],-1.2,1.2);
    vel[i]=v6Clamp(vel[i],-4.5,4.5);
  }
}
function updateShake(dt){
  if(!currentBuilding)return;
  const key=currentBuilding.root.uniqueId+':'+currentBuilding.type;
  if(key!==v6BuildingKey){v6BuildingKey=key;v6ResetDynamics();}
  const ratio=1-Math.max(0,state.hp)/state.maxHp;
  const quake=state.phase==='wave';
  if(quake&&!v6WasQuake){v6Accumulator=0;}
  v6WasQuake=quake;
  const level=v6Clamp((state.intensityLevel-5)/10,0,1);
  const soil=v6Clamp(state.soilFactor,.78,1.42);
  const isolation=1-isoReduction()*.72;
  const baseAmplitude=quake?(.48+1.34*level)*soil*isolation:0;
  const condition=v6Clamp(state.conditionFactor,.78,1.42);
  const softening=1-ratio*(currentBuilding.type==='tower'?.46:.34);
  const baseK=(currentBuilding.type==='tower'?37:57)*softening/condition;
  const baseC=(currentBuilding.type==='tower'?4.9:6.6)*(1-ratio*.18)/Math.sqrt(condition);
  v6Accumulator=Math.min(.08,v6Accumulator+Math.min(dt,.05));
  let steps=0;
  while(v6Accumulator>=V6_STEP&&steps<10){
    const impact=quake?Math.min(1.8,Math.abs(swayVelocity)*.13+cameraKick*.52):0;
    const envelope=quake?(.82+.18*Math.sin(time*.57+.8)):0;
    const gx=baseAmplitude*envelope*(v6Signal(time,0)+impact*.34*Math.sin(time*4.25+.6));
    const gz=baseAmplitude*.43*envelope*(v6Signal(time*.93,1.9)+impact*.22*Math.sin(time*3.7+2.0));
    v6IntegrateAxis(v6X,v6VX,v6AX,gx,V6_STEP,baseK,baseC);
    v6IntegrateAxis(v6Z,v6VZ,v6AZ,gz,V6_STEP,baseK*1.16,baseC*1.08);
    const visualTargetX=quake?baseAmplitude*.036*(.72*Math.sin(time*5.7)+.28*Math.sin(time*9.1+1.2)):0;
    const visualTargetZ=quake?baseAmplitude*.018*(.65*Math.sin(time*5.0+1.5)+.35*Math.sin(time*11.0+.2)):0;
    const follow=1-Math.exp(-8.5*V6_STEP);
    v6GroundX+=(visualTargetX-v6GroundX)*follow;
    v6GroundZ+=(visualTargetZ-v6GroundZ)*follow;
    swayVelocity*=Math.exp(-5.4*V6_STEP);
    v6Accumulator-=V6_STEP;steps++;
  }
  cameraKick*=Math.exp(-3.25*dt);
  const lowX=(v6X[0]+v6X[1])*.5,midX=(v6X[2]+v6X[3])*.5,topX=(v6X[4]+v6X[5])*.5;
  const lowZ=(v6Z[0]+v6Z[1])*.5,midZ=(v6Z[2]+v6Z[3])*.5,topZ=(v6Z[4]+v6Z[5])*.5;
  const visualGain=cinematicEnabled()?1:.68;
  const rootX=v6Clamp((v6GroundX+lowX*.20)*visualGain,-.32,.32);
  const rootZ=v6Clamp((v6GroundZ+lowZ*.13)*visualGain,-.18,.18);
  const rootRot=v6Clamp((midX-lowX)*.105*visualGain,-.035,.035);
  currentBuilding.root.position.x+=rootX;
  currentBuilding.root.position.z+=rootZ;
  currentBuilding.root.rotation.z+=rootRot;
  currentBuilding.root.rotation.x=v6Clamp((midZ-lowZ)*.045*visualGain,-.018,.018);
  lastMotion.rootX=rootX;lastMotion.rootZ=rootZ;lastMotion.rootRot=rootRot;
  if(currentBuilding.type==='tower'){
    const lowerRot=v6Clamp((midX-lowX)*.17*visualGain,-.065,.065);
    const upperRot=v6Clamp((topX-midX)*.24*visualGain,-.13,.13);
    const upperX=v6Clamp(((topX-midX)*1.45+topX*.42)*visualGain,-1.05,1.05);
    currentBuilding.refs.lower.rotation.z+=lowerRot;
    currentBuilding.refs.upper.rotation.z+=upperRot;
    currentBuilding.refs.upper.position.x+=upperX;
    lastMotion.lowerRot=lowerRot;lastMotion.upperRot=upperRot;lastMotion.upperX=upperX;
  }
  if(cinematicEnabled()&&quake){
    // Impulsos de cámara de baja amplitud; ArcRotateCamera aplica su propia inercia.
    const camEnergy=v6Clamp(Math.abs(v6AX[0])*.035+cameraKick*.16,0,.9);
    camera.inertialAlphaOffset+=Math.sin(time*4.8+.3)*camEnergy*.00032;
    camera.inertialBetaOffset+=Math.sin(time*3.9+1.7)*camEnergy*.00017;
  }
  lastCameraAlphaOffset=lastCameraBetaOffset=0;
}
function updateAlarms(){const on=(state.phase==='warning'||state.phase==='wave') && alarmCount()>0; defenses.forEach(d=>{if(d.type==='alarm' && d.root.alarmBeacon){const blink=on?(Math.sin(time*9+d.root.uniqueId)>0):false; d.root.alarmBeacon.material=blink?mats.alarmGlow:mats.alarm; d.root.alarmRing.isVisible=on; d.root.alarmRing.scaling.x=d.root.alarmRing.scaling.z=1+(Math.sin(time*5+d.root.uniqueId)+1)*.3;}});}
function startMusic(){if(state.musicStarted)return;const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ctx=new AC();const master=ctx.createGain();master.gain.value=.024;master.connect(ctx.destination);const osc1=ctx.createOscillator(),osc2=ctx.createOscillator(),osc3=ctx.createOscillator(),g1=ctx.createGain(),g2=ctx.createGain(),g3=ctx.createGain();osc1.type='triangle';osc2.type='sine';osc3.type='sine';osc1.frequency.value=55;osc2.frequency.value=82.4;osc3.frequency.value=123.5;g1.gain.value=.42;g2.gain.value=.13;g3.gain.value=.055;osc1.connect(g1);g1.connect(master);osc2.connect(g2);g2.connect(master);osc3.connect(g3);g3.connect(master);osc1.start();osc2.start();osc3.start();state.music={ctx,master,osc1,osc2,osc3};state.musicStarted=true;}
function updateMusic(){if(!state.musicStarted||!state.music)return;const m=state.music;const tension=(1-Math.max(0,state.hp)/state.maxHp)+((state.intensityLevel-5)/10)*.60+(state.phase==='wave'?.42:state.phase==='warning'?.14:0);const now=m.ctx.currentTime;m.master.gain.setTargetAtTime(.016+tension*.020,now,.45);m.osc1.frequency.setTargetAtTime(55*(1+tension*.09),now,.45);m.osc2.frequency.setTargetAtTime(82.4*(1+tension*.14),now,.45);m.osc3.frequency.setTargetAtTime(123.5*(1+tension*.18),now,.45);}
scene.onPointerObservable.add(info=>{const mesh=info.pickInfo?.pickedMesh; if(info.type===B.PointerEventTypes.POINTERMOVE && buildType){const padId=mesh?.metadata?.id; if(mesh?.metadata?.pickKind==='pad' && padId && !occupancyMap.has(padId) && state.phase==='build' && state.credits>=cost[buildType] && state.previewMode==='intact'){const m=padMeshes.get(padId); ghostRoot.position.set(m.position.x,.12,m.position.z); ghostRoot.setEnabled(true);} else ghostRoot.setEnabled(false); return;} if(info.type!==B.PointerEventTypes.POINTERPICK || !mesh) return; const md=mesh.metadata; if(buildType){if(md?.pickKind==='pad' && !occupancyMap.has(md.id) && state.phase==='build' && state.previewMode==='intact'){ if(state.credits<cost[buildType]){toast('No hay créditos suficientes.','bad'); return;} const pad=padMeshes.get(md.id); state.credits-=cost[buildType];state.uiDirty=true; const d=createDefense(buildType,md.id,pad.position); toast(buildType==='isolator'?'Aislador instalado.':'Alarma instalada.','good'); setBuild(null); showInspector('defense',d.id); highlight(d.root,buildType==='alarm'?'#ffabab':'#7fe1d3'); updateHud(); } return; } if(md?.pickKind==='building'){highlight(currentBuilding.root); showInspector('building','active');} else if(md?.pickKind==='defense'){const d=defenses.get(md.id); if(!d)return; highlight(d.root,d.type==='alarm'?'#ffabab':'#7fe1d3'); showInspector('defense',d.id);} });
document.querySelectorAll('.buildBtn').forEach(btn=>btn.addEventListener('click',()=>{makeGhost(btn.dataset.build); setBuild(btn.dataset.build);}));
$('sellBtn').addEventListener('click',sellSelected); $('repairBtn').addEventListener('click',repair); $('quickStart').addEventListener('click',startWave); $('enterBtn').addEventListener('click',async()=>{startMusic();if(state.music&&state.music.ctx.state==='suspended'){try{await state.music.ctx.resume();}catch(e){}}$('startModal').style.display='none';toast('V6 activa: respuesta estructural suave a 120 Hz.','good');});  $('applyScene').addEventListener('click',()=>{state.intensityLevel=parseInt($('intensityRange').value,10);state.soilFactor=parseFloat($('soilSelect').value);state.conditionFactor=parseFloat($('conditionSelect').value);state.animationMode=$('animationMode').value;engine.setHardwareScalingLevel(parseFloat($('qualitySelect').value));const selectedBuilding=$('buildingSelect').value;loadBuilding(selectedBuilding);v6BuildingKey='';rebuildMissionStats(true);toast('Escenario V6 actualizado.','good');}); $('resetMission').addEventListener('click',()=>{v6ResetDynamics();rebuildMissionStats(true); toast('Misión reiniciada.','good');}); $('previewDestroyed').addEventListener('click',destroyPreview); $('previewIntact').addEventListener('click',restorePreview);
$('buildingSelect').addEventListener('change',()=>{state.intensityLevel=parseInt($('intensityRange').value,10); state.soilFactor=parseFloat($('soilSelect').value); state.conditionFactor=parseFloat($('conditionSelect').value);state.animationMode=$('animationMode').value; loadBuilding($('buildingSelect').value);v6BuildingKey='';rebuildMissionStats(true);}); $('intensityRange').addEventListener('input',()=>{$('intensityOut').value=$('intensityRange').value; state.intensityLevel=parseInt($('intensityRange').value,10);}); $('occupancyRange').addEventListener('input',()=>{$('occupancyOut').value=$('occupancyRange').value;}); $('qualitySelect').addEventListener('change',()=>{engine.setHardwareScalingLevel(parseFloat($('qualitySelect').value));toast('Calidad gráfica actualizada.','good');}); $('animationMode').addEventListener('change',()=>{state.animationMode=$('animationMode').value;resetMotionState();v6ResetDynamics();toast(state.animationMode==='cinematic'?'V6 Realista activada.':'V6 Fluida activada.','good');});
window.addEventListener('keydown',e=>{if(e.key==='1'){makeGhost('isolator'); setBuild('isolator');} if(e.key==='2'){makeGhost('alarm'); setBuild('alarm');} if(e.key==='Escape') setBuild(null); if(e.code==='Space'){e.preventDefault(); if(state.gameOver) return; state.paused=!state.paused; setPhase(state.paused?'PAUSA':state.phase==='build'?'PREPARACIÓN':state.phase==='warning'?'ALERTA':'EVENTO EN CURSO');}});
window.addEventListener('resize',()=>engine.resize());
// Etiquetas V6 sin aumentar el peso del HTML principal.
if($('animationMode')){const opts=$('animationMode').options;if(opts[0])opts[0].textContent='V6 Fluida · PC modesta';if(opts[1])opts[1].textContent='V6 Realista · recomendado';const cores=navigator.hardwareConcurrency||4;$('animationMode').value=cores>=6?'cinematic':'performance';}
const brandTag=document.querySelector('.brand p');if(brandTag)brandTag.textContent='V6 · RESPUESTA ESTRUCTURAL';
const brandSub=document.querySelector('.brand .sub');if(brandSub)brandSub.textContent='Respuesta sísmica V6: movimiento del terreno irregular, inercia por altura, amortiguamiento y colapso progresivo.';
loadBuilding('tower'); rebuildMissionStats(true); updateHud(); highlight(currentBuilding.root); showInspector('building','active');
let last=performance.now(),lastRender=0,lastFx=0,lastUi=0,lastAudio=0;engine.runRenderLoop(()=>{const now=performance.now();const targetFrameMs=cinematicEnabled()?22:33;if(now-lastRender<targetFrameMs)return;const dt=Math.min(.05,(now-last)/1000);last=now;lastRender=now;if(!state.paused){time+=dt;if(now-lastAudio>500){updateMusic();lastAudio=now;}if(state.gameOver&&state.hp<=0){collapseProgress=Math.min(1,collapseProgress+dt*(cinematicEnabled()?.34:.46));if(!v6CollapseFxFired&&collapseProgress>.42){v6CollapseFxFired=true;spawnCinematicFx(1.15,true);}}
  // V6 recalcula primero la pose base de daño en cada frame. Esto evita saltos al
  // mezclar daño progresivo con la respuesta dinámica del edificio.
  const collapseEase=collapseProgress*collapseProgress*(3-2*collapseProgress);
  if(state.previewMode==='destroyed'){const c=state.gameOver?collapseEase:1;applyDamageVisual(1,c);}else{const ratio=1-Math.max(0,state.hp)/state.maxHp;applyDamageVisual(ratio,collapseEase);}
  if(now-lastFx>(cinematicEnabled()?70:110)){updateAlarms();lastFx=now;}
  updateCinematicFx(dt);if(!state.gameOver){if(state.phase==='warning'||state.phase==='wave')updateEvac(dt);if(state.phase==='wave')updateWave(dt);updatePulses(dt);updatePeople(dt);updateShake(dt);if(state.hp<=0&&!state.gameOver)finishGame(false);}else{updatePeople(dt);if(state.hp<=0)updateShake(dt);}if(now-lastUi>200||state.uiDirty){updateHud();state.uiDirty=false;lastUi=now;}}scene.render();});
})();
</script>
</body>
</html>
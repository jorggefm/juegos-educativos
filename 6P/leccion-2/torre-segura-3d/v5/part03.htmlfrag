function loadBuilding(type){disposeCurrentBuilding();state.buildingType=type;currentBuilding= type==='corner'?createCornerModel():createTowerModel();camera.setTarget(new B.Vector3(type==='corner'?-1.8:0,6.5,1));resetPads();state.previewMode='intact';showInspector('building','active');}
function applyDamageVisual(ratio, collapse=0){if(!currentBuilding)return;currentBuilding.root.position.x-=lastMotion.rootX;currentBuilding.root.position.z-=lastMotion.rootZ;currentBuilding.root.rotation.z-=lastMotion.rootRot;if(currentBuilding.type==='tower'){currentBuilding.refs.lower.rotation.z-=lastMotion.lowerRot;currentBuilding.refs.upper.rotation.z-=lastMotion.upperRot;currentBuilding.refs.upper.position.x-=lastMotion.upperX;}lastMotion={rootX:0,rootZ:0,rootRot:0,lowerRot:0,upperRot:0,upperX:0};const refs=currentBuilding.refs;const root=currentBuilding.root; if(currentBuilding.type==='tower'){const severe=Math.max(0,(ratio-.16)/.84); if(collapse>0){root.rotation.z=-0.22 - collapse*.92; root.position.x=6.1*collapse; root.position.y=-2.2*collapse; refs.upper.rotation.z=-0.5 - collapse*1.32; refs.upper.position.x=2.9+collapse*3.2; refs.upper.position.y=13.8-3.2*collapse;} else {root.rotation.z=-0.11*severe; root.position.y=0; root.position.x=.7*severe; refs.upper.rotation.z=-0.2*Math.max(0,(ratio-.24)/.76); refs.upper.position.x=1.8*Math.max(0,(ratio-.38)/.62); refs.upper.position.y=13.8;} refs.crack1.isVisible=ratio>.14; refs.crack2.isVisible=ratio>.28; refs.voidHole.isVisible=ratio>.56; refs.debris2.forEach(m=>m.isVisible=ratio>.34); refs.debris3.forEach(m=>m.isVisible=ratio>.58); refs.ruin.forEach(m=>m.isVisible=collapse>.35 || state.previewMode==='destroyed'); if(ratio>.3&&!refs.stage2){refs.stage2=true;refs.modules.filter((_,i)=>i%7===0||i%9===0).forEach(m=>m.isVisible=false);} if(ratio>.56&&!refs.stage3){refs.stage3=true;refs.modules.f
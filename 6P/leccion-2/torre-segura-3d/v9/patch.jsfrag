// V9 · Laboratorio de estabilidad: comparador de configuraciones completas.
const v9={active:true,running:false,pending:null,side:'A',cycles:0,accumulator:0,records:{A:[],B:[]},groundRoot:null,modelVisual:[],groundX:0,introSeen:false,cityBuilt:false,configs:{A:{base:'wide',height:'none',brace:'none',soil:'none',condition:'none',mass:'none',isolator:'none'},B:{base:'narrow',height:'none',brace:'none',soil:'none',condition:'none',mass:'none',isolator:'none'}}};
const v9Conditions=[{key:'base',label:'Base',options:[['none','No usar'],['wide','Ancha'],['narrow','Estrecha']],strength:{none:0,wide:4,narrow:-4}},{key:'height',label:'Altura',options:[['none','No usar'],['low','Baja'],['high','Alta']],strength:{none:0,low:5,high:-5}},{key:'brace',label:'Diagonales',options:[['none','No usar'],['yes','Con protección'],['no','Sin protección']],strength:{none:0,yes:5,no:-5}},{key:'soil',label:'Terreno',options:[['none','No usar'],['rock','Roca firme'],['soft','Relleno blando']],strength:{none:0,rock:6,soft:-6}},{key:'condition',label:'Estado',options:[['none','No usar'],['sound','Sin daño previo'],['damaged','Con daño previo']],strength:{none:0,sound:6,damaged:-6}},{key:'mass',label:'Carga alta',options:[['none','No usar'],['light','Ligera'],['heavy','Pesada']],strength:{none:0,light:4,heavy:-4}},{key:'isolator',label:'Aisladores',options:[['none','No usar'],['yes','Con aisladores'],['no','Sin aisladores']],strength:{none:0,yes:6,no:-6}}];
function v9Config(side=v9.side){return v9.configs[side];}function v9Name(key,value){const item=v9Conditions.find(c=>c.key===key);return item?.options.find(o=>o[0]===value)?.[1]||value;}function v9Summary(side){const c=v9Config(side),active=v9Conditions.filter(item=>c[item.key]!=='none');return active.length?active.map(item=>`${item.label}: ${v9Name(item.key,c[item.key])}`).join(' · '):'Sin variables activas: se observa la torre de referencia.';}function v9Score(side=v9.side){const c=v9Config(side);return v9Conditions.reduce((sum,item)=>sum+item.strength[c[item.key]],38);}function v9Limit(){return Math.max(14,Math.min(60,v9Score()));}function v9DamageFactor(){return Math.max(.48,Math.min(1.52,1-(v9Score()-38)*.018));}function v9FinalIntegrity(){return Math.max(18,Math.min(94,Math.round(18+v9Limit()*1.27)));}function v9Text(id,value){const el=$(id);if(el)el.textContent=value;}function v9Button(id,disabled){const el=$(id);if(el)el.disabled=!!disabled;}
const v9Style=document.createElement('style');v9Style.textContent=`#labPanel{position:fixed;z-index:8;left:16px;top:104px;width:min(430px,calc(100vw - 32px));max-height:calc(100vh - 122px);overflow:auto;padding:17px;border-radius:16px;background:rgba(248,252,255,.80);backdrop-filter:blur(16px) saturate(1.1);box-shadow:0 16px 38px #17374c42;color:#10293b;pointer-events:auto}#labPanel h2{margin:0 0 5px;font-size:22px;letter-spacing:-.03em}#labPanel p{margin:0 0 10px;color:#40596b;font-size:12px;line-height:1.42}.lab-configs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.lab-config{padding:10px;border-radius:12px;background:#ffffff99;box-shadow:inset 0 0 0 1px #c8dbe4;cursor:pointer}.lab-config.on{box-shadow:inset 0 0 0 2px #237b78}.lab-config h3{margin:0 0 7px;font-size:13px;color:#164356}.lab-config label{display:grid;gap:2px;margin:6px 0;font-size:10px;font-weight:900;color:#456277}.lab-config select{width:100%;min-height:32px;padding:5px;border:1px solid #bad0dc;border-radius:7px;background:#fff;color:#19364a;font:inherit;font-size:11px;cursor:pointer}.lab-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 0}.lab-row button{min-height:44px;border:1px solid #b9cfdd;border-radius:11px;background:rgba(255,255,255,.82);color:#163147;padding:8px;font-weight:800;font:inherit;font-size:12px;box-shadow:0 2px 7px #31536a12}.lab-row button.primary{background:#237b78;color:#fff;border-color:#237b78}.lab-row button:disabled{opacity:.42}.lab-status{display:flex;justify-content:space-between;gap:8px;margin:10px 0;padding:10px 11px;border-radius:11px;background:#e6f4f1;color:#173b47;font-size:12px}.lab-status strong{color:#925b17}.lab-variable{margin:8px 0;padding:9px 10px;border-radius:11px;background:#d8efea;color:#16494a;font-size:12px;font-weight:900}.lab-note{margin-top:9px;color:#486274;font-size:10px;line-height:1.38}.lab-help{margin:9px 0;padding:9px 10px;border-radius:10px;background:#eff6fa;color:#35586b;font-size:10px;line-height:1.4}.lab-data{max-height:230px;overflow:auto;margin-top:9px;font-size:11px}.lab-data table{width:100%;border-collapse:collapse}.lab-data th,.lab-data td{padding:5px;border-bottom:1px solid #b8cbd6;text-align:left}.lab-bars{display:grid;gap:5px;margin-top:8px}.lab-bar{display:grid;grid-template-columns:104px 1fr 58px;gap:6px;align-items:center}.lab-bar span{height:8px;background:#237b78;border-radius:4px}.lab-questions{margin-top:10px;padding:12px;border-radius:12px;background:#eff6fa;color:#254a5e}.lab-questions h3{margin:0 0 7px;font-size:14px}.lab-questions ol{margin:0;padding-left:20px;display:grid;gap:8px;font-size:12px;line-height:1.35}.lab-toggle{position:fixed;z-index:9;right:16px;bottom:16px;pointer-events:auto}.lab-toggle button{border:0;border-radius:12px;background:#f7fbfdde;color:#143247;padding:12px 14px;font-weight:900;box-shadow:0 10px 24px #19384b30}.v9Lab .left,.v9Lab .quickInfo,.v9Lab .alarmBadge,.v9Lab .fireBadge,.v9Lab #quickStart{display:none!important}.v9Lab .brand .sub{max-width:310px}.v9Lab .pills{max-width:52vw}.v9Lab #warning{max-width:460px;margin-left:auto;margin-right:auto}.lab-intro{position:fixed;z-index:20;inset:0;display:grid;place-items:center;padding:22px;background:#10243675;backdrop-filter:blur(5px);pointer-events:auto}.lab-intro.hidden{display:none}.lab-intro-card{width:min(520px,100%);padding:28px;border-radius:16px;background:#f7fbfd;color:#112e43;box-shadow:0 24px 70px #06132178}.lab-intro-card h2{margin:0 0 10px;font-size:30px;letter-spacing:-.035em}.lab-intro-card p{margin:0 0 13px;color:#456073;line-height:1.45}.lab-intro-steps{margin:16px 0;padding:0;list-style:none;display:grid;gap:8px}.lab-intro-steps li{padding:9px 0;border-bottom:1px solid #d6e3e9;color:#24475d;font-size:14px}.lab-intro-steps b{color:#176c6b}.lab-intro-actions{display:flex;gap:10px;align-items:center;margin-top:19px}.lab-intro-actions button{border:0;border-radius:11px;padding:11px 14px;background:#237b78;color:#fff;font-weight:900}.lab-intro-actions button:last-child{background:transparent;color:#31586c}.v9Lab ::selection{background:#a8ded4;color:#0d2b3c}.v9Lab button:focus-visible,.v9Lab select:focus-visible{outline:3px solid #eaad4d;outline-offset:2px}@media(max-width:1023px){.v9Lab .pills{display:none}#labPanel{left:12px;right:12px;top:auto;bottom:max(12px,env(safe-area-inset-bottom));width:auto;max-height:min(70dvh,650px);padding:14px}.lab-config select{min-height:44px;font-size:13px}.lab-config label{font-size:11px}.lab-toggle{right:12px;bottom:calc(max(12px,env(safe-area-inset-bottom)) + 12px)}.v9Lab .brand h1{font-size:28px}}@media(max-width:640px){#labPanel{max-height:76dvh}.lab-configs{grid-template-columns:1fr}.lab-row{grid-template-columns:1fr}.lab-status{align-items:flex-start;flex-direction:column}.lab-intro{padding:14px}.lab-intro-card{padding:20px}.lab-intro-card h2{font-size:25px}.lab-toggle button{min-height:44px}}@media(orientation:landscape) and (max-width:1023px){#labPanel{left:12px;right:auto;bottom:12px;width:min(390px,calc(100vw - 24px));max-height:calc(100dvh - 116px)}}@media(pointer:coarse){.lab-config select,.lab-row button,.lab-toggle button{min-height:44px}}`;document.head.appendChild(v9Style);
function v9ConfigMarkup(side,title){return `<article class="lab-config ${side==='A'?'on':''}" id="labConfig${side}"><h3>${title}</h3>${v9Conditions.map(item=>`<label>${item.label}<select data-v9-side="${side}" data-v9-key="${item.key}">${item.options.map(o=>`<option value="${o[0]}">${o[1]}</option>`).join('')}</select></label>`).join('')}</article>`;}
const v9Panel=document.createElement('section');v9Panel.id='labPanel';v9Panel.innerHTML=`<h2>Compara configuraciones</h2><p id="labPrompt">Activa solo las variables que quieras estudiar. Haz clic en una configuración para verla y ensayarla.</p><div class="lab-configs">${v9ConfigMarkup('A','Configuración 1')}${v9ConfigMarkup('B','Configuración 2')}</div><div id="labVariable" class="lab-variable">ENSAYARÁS · Configuración 1</div><div class="lab-status"><span id="labModelLabel">Haz clic en una configuración para seleccionarla</span><strong id="labCycle">0 / 60 golpes</strong></div><div class="lab-row"><button id="labStart" class="primary">Iniciar sacudida</button><button id="labPause">Pausa</button></div><div class="lab-row"><button id="labSave" disabled>Guardar resultado</button><button id="labReset">Nueva comparación</button></div><div class="lab-row"><button id="labView">Ver resultado comparado</button><button id="labQuestionsToggle" aria-expanded="false">Preguntas para tu cuaderno</button></div><div id="labData" class="lab-data hidden"></div><div id="labSceneHint" class="lab-note"></div><div class="lab-help"><b>Golpes soportados</b> son sacudidas iguales que resiste la torre antes de detener el ensayo. Más golpes indican mayor resistencia. <b>Integridad final</b> muestra cómo quedó el edificio al terminar: ambos datos forman el resultado de la comparación.</div><section id="labQuestions" class="lab-questions hidden" aria-labelledby="labQuestionsTitle"><h3 id="labQuestionsTitle">Preguntas para tu cuaderno</h3><ol><li>¿Qué variable o variables activaste en cada configuración?</li><li>¿Cuál configuración soportó más golpes? Escribe el dato que registraste.</li><li>¿Cómo terminó la integridad de cada edificio y qué indica esa diferencia?</li><li>¿Qué condición parece proteger más al edificio según tus resultados?</li><li>¿Qué cambio harías en una configuración para que resista mejor? Explica tu razón.</li></ol></section>`;document.body.appendChild(v9Panel);
const v9Intro=document.createElement('section');v9Intro.id='labIntro';v9Intro.className='lab-intro hidden';v9Intro.innerHTML=`<div class="lab-intro-card"><h2>¿Qué configuración protege mejor al edificio?</h2><p>Configura dos edificios y activa una, varias o las siete variables en cada uno. Ambos recibirán la misma sacudida.</p><ul class="lab-intro-steps"><li><b>Activa</b> solo las variables que quieras estudiar; deja las demás en “No usar”.</li><li><b>Selecciona</b> una configuración haciendo clic en su panel.</li><li><b>Prueba</b> ambas y compara golpes soportados e integridad final.</li></ul><div class="lab-intro-actions"><button id="labIntroStart">Comenzar a comparar</button><button id="labIntroSkip">Explorar sin guía</button></div></div>`;document.body.appendChild(v9Intro);const v9Toggle=document.createElement('div');v9Toggle.className='lab-toggle';v9Toggle.innerHTML='<button id="labModeToggle">Exploración libre</button>';document.body.appendChild(v9Toggle);
$('labQuestions').innerHTML='<h3 id="labQuestionsTitle">Preguntas para tu cuaderno</h3><ol><li>Antes de probar, ¿cuál configuración crees que resistirá más? ¿Por qué?</li><li>¿Qué crees que ocurrirá con una torre alta frente a una torre baja?</li><li>¿Qué terreno piensas que protege mejor: roca firme o relleno blando?</li><li>¿Crees que los aisladores y las diagonales ayudarán? Explica tu predicción.</li><li>Después del ensayo, ¿tu predicción fue correcta? ¿Qué dato lo demuestra?</li></ol>';
function v9GroundSetup(){if(v9.groundRoot)return;v9.groundRoot=new B.TransformNode('v9GroundRoot',scene);const meshNames=/^(ground|lot|road|road2|safe|safe2|line|bar)/;scene.meshes.filter(m=>meshNames.test(m.name)).forEach(m=>m.parent=v9.groundRoot);scene.transformNodes.filter(n=>/^(fenceRoot|car\d+)/.test(n.name)).forEach(n=>n.parent=v9.groundRoot);v9BuildCity();}
function v9BuildCity(){if(v9.cityBuilt)return;v9.cityBuilt=true;const city=new B.TransformNode('v9City',scene);city.parent=v9.groundRoot;[[14,5,-11,5,10,4],[19,7,-7,5,14,4],[-13,4,-13,5,8,4],[-20,6,-8,4,12,5],[14,3,8,6,6,4]].forEach((d,i)=>{const b=B.MeshBuilder.CreateBox('cityBlock'+i,{width:d[3],height:d[4],depth:d[5]},scene);b.parent=city;b.position.set(d[0],d[1]/2,d[2]);b.material=i%2?mats.beige:mats.annex;b.isPickable=false;for(let floor=0;floor<Math.floor(d[4]/2);floor++){const w=B.MeshBuilder.CreateBox('cityWindow'+i+'_'+floor,{width:d[3]*.62,height:.34,depth:.07},scene);w.parent=city;w.position.set(d[0],1.1+floor*1.7,d[2]+d[5]/2+.05);w.material=mats.window;w.isPickable=false;}});[-14,-10,11,16].forEach((x,i)=>{const trunk=B.MeshBuilder.CreateCylinder('cityTree'+i,{height:2,diameter:.18,tessellation:7},scene);trunk.parent=city;trunk.position.set(x,1,9-i%2*2);trunk.material=mats.debrisDark;const crown=B.MeshBuilder.CreateSphere('cityCrown'+i,{diameter:1.4,segments:8},scene);crown.parent=city;crown.position.set(x,2.3,9-i%2*2);crown.material=mats.ground;});}
function v9AttachTowerToGround(){if(currentBuilding&&v9.groundRoot&&currentBuilding.root.parent!==v9.groundRoot)currentBuilding.root.parent=v9.groundRoot;}function v9ClearVisual(){v9.modelVisual.forEach(m=>{if(!m.isDisposed?.())m.dispose();});v9.modelVisual=[];}function v9SceneLabel(root,text){const plane=B.MeshBuilder.CreatePlane('v9SceneLabel',{width:5.6,height:.78},scene),texture=new B.DynamicTexture('v9SceneLabelTexture',{width:560,height:80},scene,false),ctx=texture.getContext();ctx.fillStyle='#f7fbfd';ctx.fillRect(0,0,560,80);ctx.fillStyle='#12384b';ctx.font='bold 32px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(text,280,40);texture.update();const material=new B.StandardMaterial('v9SceneLabelMaterial',scene);material.diffuseTexture=texture;material.emissiveColor=B.Color3.FromHexString('#ffffff');material.backFaceCulling=false;plane.parent=root;plane.position.set(0,16.7,3.64);plane.rotation.y=Math.PI;plane.material=material;plane.isPickable=false;v9.modelVisual.push(plane);}
function v9ApplyConfig(){if(!currentBuilding)return;v9ClearVisual();const c=v9Config(),root=currentBuilding.root;root.scaling.y=c.height==='low'?.74:c.height==='high'?1.14:1;v9SceneLabel(root,`CONFIGURACIÓN ${v9.side==='A'?1:'2'}`);if(c.base!=='none'){const plate=B.MeshBuilder.CreateBox('v9Base',{width:c.base==='wide'?11.6:6.8,height:.28,depth:c.base==='wide'?8.8:5.6},scene);plate.parent=root;plate.position.set(0,.14,0);plate.material=c.base==='wide'?mats.safe:mats.debris;plate.isPickable=false;v9.modelVisual.push(plate);}if(c.brace==='yes')[-1,1].forEach(side=>{const brace=B.MeshBuilder.CreateBox('v9Brace',{width:.16,height:14,depth:.14},scene);brace.parent=root;brace.position.set(side*2.6,7,3.55);brace.rotation.z=side*.38;brace.material=mats.rail;brace.isPickable=false;v9.modelVisual.push(brace);});if(c.soil!=='none'){const soil=B.MeshBuilder.CreateCylinder('v9Soil',{diameter:c.soil==='rock'?13:11,height:.08,tessellation:36},scene);soil.parent=root;soil.position.set(0,.05,0);soil.material=c.soil==='rock'?mats.safe:mats.pulseSurface;soil.isPickable=false;v9.modelVisual.push(soil);}if(c.condition==='damaged')[-1.7,.2,1.6].forEach((x,i)=>{const crack=B.MeshBuilder.CreateBox('v9PreDamage',{width:.12,height:3.8-i*.5,depth:.08},scene);crack.parent=root;crack.position.set(x,6.5+i*3.1,3.62);crack.rotation.z=.25*(i-1);crack.material=mats.crack;crack.isPickable=false;v9.modelVisual.push(crack);});if(c.mass!=='none'){const count=c.mass==='light'?1:5;for(let i=0;i<count;i++){const load=B.MeshBuilder.CreateBox('v9Load',{width:1.05,height:.45,depth:.72},scene);load.parent=root;load.position.set((i%2-.5)*1.25,18.9+Math.floor(i/2)*.5,3.75);load.material=mats.debris;load.isPickable=false;v9.modelVisual.push(load);}}if(c.isolator==='yes')[-3,0,3].forEach(x=>{const iso=B.MeshBuilder.CreateTorus('v9Isolator',{diameter:1.05,thickness:.18,tessellation:20},scene);iso.parent=root;iso.position.set(x,.22,0);iso.rotation.x=Math.PI/2;iso.material=mats.isolator;iso.isPickable=false;v9.modelVisual.push(iso);});}
function v9RenderData(){const all=[...v9.records.A,...v9.records.B],max=Math.max(1,...all.map(r=>r.cycles));const rows=['A','B'].map(side=>v9.records[side].map(r=>`<tr><td>Configuración ${side==='A'?1:2}</td><td>${r.cycles} golpes</td><td>${r.integrity}%</td></tr>`).join('')).join('')||'<tr><td colspan="3">Aún no hay resultados: ensaya una configuración.</td></tr>';const bars=['A','B'].map(side=>{const r=v9.records[side][0],value=r?r.cycles:0;return `<div class="lab-bar"><b>Configuración ${side==='A'?1:2}</b><span style="width:${value/max*100}%"></span><em>${value} g</em></div>`;}).join('');$('labData').innerHTML=`<table><thead><tr><th>Configuración</th><th>Golpes soportados</th><th>Integridad final</th></tr></thead><tbody>${rows}</tbody></table><div class="lab-bars">${bars}</div>`;}
function v9Render(){const title=`Configuración ${v9.side==='A'?1:2}`;v9Text('labModelLabel',`Seleccionada: ${title}`);v9Text('labCycle',`${v9.cycles} / 60 golpes`);v9Text('labVariable',`ENSAYARÁS · ${title}`);v9Text('labSceneHint',v9Summary());document.querySelectorAll('.lab-config').forEach(el=>el.classList.toggle('on',el.id===`labConfig${v9.side}`));document.querySelectorAll('[data-v9-side]').forEach(el=>{const side=el.dataset.v9Side,key=el.dataset.v9Key;if(el.value!==v9.configs[side][key])el.value=v9.configs[side][key];});v9Button('labStart',v9.running||!!v9.pending||v9.records[v9.side].length>=1);v9Button('labPause',!v9.running);v9Button('labSave',!v9.pending);v9RenderData();}
function v9ResetTrial(){state.gameOver=false;state.hp=100;state.burning=false;state.previewMode='intact';collapseProgress=0;v9.cycles=0;v9.accumulator=0;v9.pending=null;resetBuildingVisualState();v9ApplyConfig();$('collapseBadge').classList.remove('on');}function v9ResetComparison(){v9.running=false;v9.pending=null;v9.records={A:[],B:[]};v9ResetTrial();v9Text('labPrompt','Comparación reiniciada. Elige una configuración y comienza un nuevo versus.');v9Render();}function v9Finish(){if(!v9.running)return;v9.running=false;state.phase='build';state.paused=false;state.hp=v9FinalIntegrity();setPhase('ENSAYO FINALIZADO');v9.pending={cycles:v9.cycles,integrity:state.hp};v9Text('labPrompt','Ensayo finalizado. Guarda golpes soportados e integridad final para comparar.');toast(`Ensayo finalizado tras ${v9.cycles} golpes.`,'warn');v9Render();}function v9Start(){if(v9.records[v9.side].length)return;v9ResetTrial();v9.running=true;state.phase='wave';setPhase('SACUDIDA EN CURSO');v9Text('labPrompt','La torre recibe golpes iguales durante hasta 60 golpes. Observa el terreno, la base y la parte alta.');v9Render();}function v9Save(){if(!v9.pending)return;v9.records[v9.side]=[v9.pending];v9.pending=null;v9Text('labPrompt','Resultado guardado. Haz clic en la otra configuración para completar el versus, o inicia una nueva comparación.');v9Render();}
function v9Step(dt){if(!v9.active){if(v9.groundRoot){v9.groundRoot.position.x=0;v9.groundRoot.rotation.z=0;}return;}v9GroundSetup();v9AttachTowerToGround();const moving=v9.running,target=moving?Math.sin(time*7.2)*.72:0;v9.groundX+=(target-v9.groundX)*(1-Math.exp(-15*dt));v9.groundRoot.position.x=v9.groundX;v9.groundRoot.rotation.z=moving?Math.sin(time*7.2)*.012:0;if(!moving)return;v9.accumulator+=dt;if(v9.accumulator>=.42){v9.accumulator-=.42;v9.cycles++;applyDamage({intensity:.014+(v9.cycles%5)*.0007,type:'fast'});if(v9.cycles>=v9Limit())v9Finish();else if(v9.cycles>=60)v9Finish();v9Render();}}
const v9BaseApplyDamage=applyDamage;applyDamage=function(p){if(v9.running&&currentBuilding){const f=currentBuilding.fragility;currentBuilding.fragility=f*v9DamageFactor();v9BaseApplyDamage(p);currentBuilding.fragility=f;return;}v9BaseApplyDamage(p);};const v9BaseUpdateShake=updateShake;updateShake=function(dt){v9BaseUpdateShake(dt);v9Step(dt);};const v9BaseFinishGame=finishGame;finishGame=function(win){if(v9.running){v9Finish('Colapsó');state.gameOver=true;return;}v9BaseFinishGame(win);};
function v9SetMode(lab){v9.active=lab;document.body.classList.toggle('v9Lab',lab);$('labPanel').classList.toggle('hidden',!lab);v9Toggle.classList.remove('hidden');$('labModeToggle').textContent=lab?'Exploración libre':'Laboratorio de estabilidad';if(lab){$('startModal').style.display='none';v9GroundSetup();v9AttachTowerToGround();v9ResetTrial();v9Render();if(!v9.introSeen)$('labIntro').classList.remove('hidden');}else{v9.running=false;state.phase='build';if(v9.groundRoot){v9.groundRoot.position.x=0;v9.groundRoot.rotation.z=0;}if(currentBuilding)currentBuilding.root.parent=null;}}
document.querySelectorAll('[data-v9-side]').forEach(select=>select.addEventListener('change',e=>{if(v9.running)return;const side=e.target.dataset.v9Side,key=e.target.dataset.v9Key;v9.side=side;v9.configs[side][key]=e.target.value;v9.records={A:[],B:[]};v9ResetTrial();v9Text('labPrompt','Variable actualizada. La comparación anterior se reinició para usar las mismas condiciones en ambos lados.');v9Render();}));document.querySelectorAll('.lab-config').forEach(card=>card.addEventListener('click',()=>{if(!v9.running){v9.side=card.id.endsWith('A')?'A':'B';v9ResetTrial();v9Text('labPrompt','Configuración seleccionada. Inicia la sacudida cuando estés listo.');v9Render();}}));$('labStart').addEventListener('click',v9Start);$('labPause').addEventListener('click',()=>{if(v9.running){state.paused=!state.paused;$('labPause').textContent=state.paused?'Continuar':'Pausa';}});$('labSave').addEventListener('click',v9Save);$('labReset').addEventListener('click',v9ResetComparison);$('labView').addEventListener('click',()=>{$('labData').classList.toggle('hidden');});$('labQuestionsToggle').addEventListener('click',()=>{const questions=$('labQuestions'),shown=questions.classList.toggle('hidden');$('labQuestionsToggle').setAttribute('aria-expanded',String(!shown));$('labQuestionsToggle').textContent=shown?'Preguntas para tu cuaderno':'Ocultar preguntas';});$('labModeToggle').addEventListener('click',()=>v9SetMode(!v9.active));$('labIntroStart').addEventListener('click',()=>{v9.introSeen=true;$('labIntro').classList.add('hidden');});$('labIntroSkip').addEventListener('click',()=>{v9.introSeen=true;$('labIntro').classList.add('hidden');});setTimeout(()=>{const tag=document.querySelector('.brand p');if(tag)tag.textContent='V9 · LABORATORIO DE ESTABILIDAD';const sub=document.querySelector('.brand .sub');if(sub)sub.textContent='Configura, compara y registra qué edificio resiste mejor.';v9SetMode(true);},0);

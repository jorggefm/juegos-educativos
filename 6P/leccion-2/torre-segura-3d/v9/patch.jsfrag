// ─────────────────────────────────────────────────────────────────────────────
// V9 LABORATORIO DE ESTABILIDAD
// A controlled, repeatable experiment layer for P02/P03. It keeps the V8
// response engine, but turns its output into comparable classroom evidence.
// ─────────────────────────────────────────────────────────────────────────────
const v9 = {
  active:true, running:false, pending:null, question:'base', model:'A', cycles:0,
  accumulator:0, elapsed:0, records:{A:[],B:[]}, groundRoot:null, modelVisual:[],
  lateral:false, groundX:0, introSeen:false
};
const v9Experiments={
  base:{label:'base del edificio',a:'Base ancha',b:'Base estrecha',limits:[24,12],damage:[.72,1.28],scene:'placa ancha bajo el edificio'},
  height:{label:'altura del edificio',a:'Torre baja',b:'Torre alta',limits:[25,13],damage:[.74,1.24],scene:'regla de altura al costado'},
  brace:{label:'protección lateral',a:'Con diagonales',b:'Sin diagonales',limits:[25,14],damage:[.70,1.20],scene:'diagonales de refuerzo en la fachada'},
  soil:{label:'tipo de terreno',a:'Roca firme',b:'Tierra blanda',limits:[26,14],damage:[.68,1.20],scene:'base de terreno bajo la torre'},
  condition:{label:'estado estructural',a:'Sin daño previo',b:'Con daño previo',limits:[25,13],damage:[.72,1.30],scene:'marcas de daño en la fachada'},
  mass:{label:'carga en la parte alta',a:'Carga ligera',b:'Carga pesada',limits:[23,13],damage:[.76,1.26],scene:'bloques de carga sobre la azotea'},
  isolator:{label:'protección sísmica',a:'Con aisladores',b:'Sin aisladores',limits:[26,14],damage:[.66,1.20],scene:'anillos azules entre la base y el terreno'}
};
function v9Experiment(){return v9Experiments[v9.question];}
function v9ModelIndex(){return v9.model==='A'?0:1;}
function v9Limit(){const n=v9.records[v9.model].length;return v9Experiment().limits[v9ModelIndex()]+[0,1,-1][n%3];}
function v9Text(id,text){const el=$(id);if(el)el.textContent=text;}
function v9Button(id,disabled){const el=$(id);if(el)el.disabled=!!disabled;}

const v9Style=document.createElement('style');
v9Style.textContent=`
  #labPanel{position:fixed;z-index:8;left:16px;top:112px;width:min(366px,calc(100vw - 32px));padding:18px;border-radius:16px;background:rgba(248,252,255,.78);backdrop-filter:blur(16px) saturate(1.1);box-shadow:0 16px 38px #17374c42;color:#10293b;pointer-events:auto}
  #labPanel h2{margin:0 0 5px;font-size:22px;letter-spacing:-.03em}#labPanel p{margin:0 0 14px;color:#40596b;font-size:12px;line-height:1.42}.lab-label{display:block;margin:12px 0 5px;font-size:11px;font-weight:900;color:#365368}.lab-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 0}.lab-row button,.lab-select{min-height:42px;border:1px solid #b9cfdd;border-radius:11px;background:rgba(255,255,255,.82);color:#163147;padding:9px;font-weight:800;font:inherit;font-size:12px;box-shadow:0 2px 7px #31536a12}.lab-row button.on,.lab-row button.primary{background:#237b78;color:#fff;border-color:#237b78}.lab-row button:disabled{opacity:.42}.lab-select{width:100%;margin:0}.lab-status{display:flex;justify-content:space-between;gap:8px;margin:10px 0;padding:10px 11px;border-radius:11px;background:#e6f4f1;color:#173b47;font-size:12px}.lab-status strong{color:#925b17}.lab-data{max-height:180px;overflow:auto;margin-top:9px;font-size:11px}.lab-data table{width:100%;border-collapse:collapse}.lab-data th,.lab-data td{padding:5px;border-bottom:1px solid #b8cbd6;text-align:left}.lab-bars{display:grid;gap:5px;margin-top:8px}.lab-bar{display:grid;grid-template-columns:105px 1fr 26px;gap:6px;align-items:center}.lab-bar span{height:8px;background:#237b78;border-radius:4px}.lab-note{margin-top:10px;color:#486274;font-size:10px;line-height:1.38}.lab-toggle{position:fixed;z-index:9;right:16px;bottom:16px;pointer-events:auto}.lab-toggle button{border:0;border-radius:12px;background:#f7fbfdde;color:#143247;padding:10px 12px;font-weight:900;box-shadow:0 10px 24px #19384b30}.v9Lab .left,.v9Lab .quickInfo,.v9Lab .alarmBadge,.v9Lab .fireBadge,.v9Lab #quickStart{display:none!important}.v9Lab .brand .sub{max-width:310px}.v9Lab .pills{max-width:52vw}.v9Lab #warning{max-width:460px;margin-left:auto;margin-right:auto}.lab-variable{margin:8px 0;padding:9px 10px;border-radius:11px;background:#d8efea;color:#16494a;font-size:12px;font-weight:900}.lab-intro{position:fixed;z-index:20;inset:0;display:grid;place-items:center;padding:22px;background:#10243675;backdrop-filter:blur(5px);pointer-events:auto}.lab-intro.hidden{display:none}.lab-intro-card{width:min(520px,100%);padding:28px;border-radius:16px;background:#f7fbfd;color:#112e43;box-shadow:0 24px 70px #06132178}.lab-intro-card h2{margin:0 0 10px;font-size:30px;letter-spacing:-.035em}.lab-intro-card p{margin:0 0 13px;color:#456073;line-height:1.45}.lab-intro-steps{margin:16px 0;padding:0;list-style:none;display:grid;gap:8px}.lab-intro-steps li{padding:9px 0;border-bottom:1px solid #d6e3e9;color:#24475d;font-size:14px}.lab-intro-steps b{color:#176c6b}.lab-intro-actions{display:flex;gap:10px;align-items:center;margin-top:19px}.lab-intro-actions button{border:0;border-radius:11px;padding:11px 14px;background:#237b78;color:#fff;font-weight:900}.lab-intro-actions button:last-child{background:transparent;color:#31586c}.v9Lab ::selection{background:#a8ded4;color:#0d2b3c}.v9Lab button:focus-visible,.v9Lab select:focus-visible{outline:3px solid #eaad4d;outline-offset:2px}@media(max-width:760px){#labPanel{top:auto;bottom:16px;max-height:65vh;overflow:auto}.v9Lab .pills{display:none}.v9Lab .brand h1{font-size:26px}.lab-intro-card{padding:22px}.lab-intro-card h2{font-size:26px}}
`;
document.head.appendChild(v9Style);

const v9Panel=document.createElement('section');
v9Panel.id='labPanel';
v9Panel.innerHTML=`<h2>Compara condiciones</h2><p id="labPrompt">Elige una condición. Solo esa cambia; la sacudida y el material se mantienen iguales.</p><label class="lab-label" for="labQuestion">¿Qué condición quieres comparar?</label><select id="labQuestion" class="lab-select" aria-label="Condición a comparar"><option value="base">Base del edificio — ancha / estrecha</option><option value="height">Altura del edificio — baja / alta</option><option value="brace">Protección lateral — con / sin diagonales</option><option value="soil">Tipo de terreno — roca / tierra blanda</option><option value="condition">Estado estructural — sin / con daño previo</option><option value="mass">Carga en la parte alta — ligera / pesada</option><option value="isolator">Protección sísmica — con / sin aisladores</option></select><div id="labVariable" class="lab-variable">AHORA OBSERVAS · Base ancha</div><div class="lab-row"><button id="labModelA" class="on">Base ancha</button><button id="labModelB">Base estrecha</button></div><div class="lab-status"><span id="labModelLabel">Base ancha</span><strong id="labCycle">0 / 30 ciclos</strong></div><div class="lab-row"><button id="labStart" class="primary">Iniciar sacudida</button><button id="labPause">Pausa</button></div><div class="lab-row"><button id="labSave" disabled>Guardar dato</button><button id="labView">Ver comparación</button></div><div id="labData" class="lab-data hidden"></div><div id="labSceneHint" class="lab-note">En la escena: placa ancha bajo el edificio.</div><div class="lab-note">Se mantienen iguales: intensidad, duración y material. Es un modelo educativo, no predice edificios reales.</div>`;
document.body.appendChild(v9Panel);
const v9Intro=document.createElement('section');
v9Intro.id='labIntro';v9Intro.className='lab-intro hidden';
v9Intro.innerHTML=`<div class="lab-intro-card"><h2>¿Cuál condición protege mejor al edificio?</h2><p>En este laboratorio compararás dos condiciones frente a la misma sacudida. Observa el terreno y la torre, registra el resultado y decide cuál protege mejor.</p><ul class="lab-intro-steps"><li><b>Elige</b> una condición: altura, terreno, estado o protección.</li><li><b>Observa</b> una alternativa en la escena.</li><li><b>Repite</b> la sacudida y compara los ciclos que resiste.</li></ul><div class="lab-intro-actions"><button id="labIntroStart">Comenzar a comparar</button><button id="labIntroSkip">Explorar sin guía</button></div></div>`;
document.body.appendChild(v9Intro);
const v9Toggle=document.createElement('div');
v9Toggle.className='lab-toggle';
v9Toggle.innerHTML='<button id="labModeToggle">Exploración libre</button>';
document.body.appendChild(v9Toggle);

function v9GroundSetup(){
  if(v9.groundRoot)return;
  v9.groundRoot=new B.TransformNode('v9GroundRoot',scene);
  const meshNames=/^(ground|lot|road|road2|safe|safe2|line|bar)/;
  scene.meshes.filter(m=>meshNames.test(m.name)).forEach(m=>m.parent=v9.groundRoot);
  scene.transformNodes.filter(n=>/^(fenceRoot|car\d+)/.test(n.name)).forEach(n=>n.parent=v9.groundRoot);
  [-8,0,8].forEach((x,i)=>{const seam=B.MeshBuilder.CreateBox('v9GroundSeam',{width:5.6,height:.035,depth:.12},scene);seam.parent=v9.groundRoot;seam.position.set(x,.13,-7.8+i*.3);seam.material=mats.pulseSurface;seam.isPickable=false;});
}
function v9AttachTowerToGround(){
  if(currentBuilding && v9.groundRoot && currentBuilding.root.parent!==v9.groundRoot)currentBuilding.root.parent=v9.groundRoot;
}
function v9ClearVisual(){v9.modelVisual.forEach(m=>{if(!m.isDisposed?.())m.dispose();});v9.modelVisual=[];}
function v9SceneLabel(root,text){
  const plane=B.MeshBuilder.CreatePlane('v9SceneLabel',{width:4.9,height:.72},scene),texture=new B.DynamicTexture('v9SceneLabelTexture',{width:512,height:80},scene,false);
  const context=texture.getContext();context.fillStyle='#f7fbfd';context.fillRect(0,0,512,80);context.fillStyle='#12384b';context.font='bold 34px Arial';context.textAlign='center';context.textBaseline='middle';context.fillText(text,256,40);texture.update();
  const material=new B.StandardMaterial('v9SceneLabelMaterial',scene);material.diffuseTexture=texture;material.emissiveColor=B.Color3.FromHexString('#ffffff');material.backFaceCulling=false;
  plane.parent=root;plane.position.set(0,16.7,3.63);plane.material=material;plane.isPickable=false;v9.modelVisual.push(plane);
}
function v9ApplyModel(){
  if(!currentBuilding)return;v9ClearVisual();
  const idx=v9ModelIndex(), root=currentBuilding.root, exp=v9Experiment();
  root.scaling.y=v9.question==='height'?(idx===0?.74:1.14):1;
  v9SceneLabel(root,exp[idx===0?'a':'b'].toUpperCase());
  if(v9.question==='base'){
    const plate=B.MeshBuilder.CreateBox('v9Base',{width:idx===0?11.6:6.8,height:.28,depth:idx===0?8.8:5.6},scene);
    plate.parent=root;plate.position.set(0,.14,0);plate.material=idx===0?mats.safe:mats.debris;plate.isPickable=false;v9.modelVisual.push(plate);
  }
  if(v9.question==='height'){
    const ruler=B.MeshBuilder.CreateBox('v9HeightMarker',{width:.22,height:idx===0?15:23,depth:.22},scene);
    ruler.parent=root;ruler.position.set(-5.1,(idx===0?15:23)/2,3.7);ruler.material=idx===0?mats.safe:mats.debris;ruler.isPickable=false;v9.modelVisual.push(ruler);
  }
  if(v9.question==='brace'&&idx===0){
    [-1,1].forEach(side=>{const brace=B.MeshBuilder.CreateBox('v9Brace',{width:.16,height:14,depth:.14},scene);brace.parent=root;brace.position.set(side*2.6,7,3.55);brace.rotation.z=side*.38;brace.material=mats.rail;brace.isPickable=false;v9.modelVisual.push(brace);});
  }
  if(v9.question==='soil'){
    const soil=B.MeshBuilder.CreateCylinder('v9Soil',{diameter:idx===0?13:11,height:.08,tessellation:36},scene);
    soil.parent=root;soil.position.set(0,.05,0);soil.material=idx===0?mats.safe:mats.pulseSurface;soil.isPickable=false;v9.modelVisual.push(soil);
  }
  if(v9.question==='condition'&&idx===1){
    [-1.7,.2,1.6].forEach((x,i)=>{const crack=B.MeshBuilder.CreateBox('v9PreDamage',{width:.12,height:3.8-i*.5,depth:.08},scene);crack.parent=root;crack.position.set(x,6.5+i*3.1,3.62);crack.rotation.z=.25*(i-1);crack.material=mats.crack;crack.isPickable=false;v9.modelVisual.push(crack);});
  }
  if(v9.question==='mass'){
    const count=idx===0?1:5;
    for(let i=0;i<count;i++){const load=B.MeshBuilder.CreateBox('v9Load',{width:1.05,height:.45,depth:.72},scene);load.parent=root;load.position.set((i%2-.5)*1.25,18.9+Math.floor(i/2)*.5,3.75);load.material=mats.debris;load.isPickable=false;v9.modelVisual.push(load);}
  }
  if(v9.question==='isolator'&&idx===0){
    [-3,0,3].forEach(x=>{const iso=B.MeshBuilder.CreateTorus('v9Isolator',{diameter:1.05,thickness:.18,tessellation:20},scene);iso.parent=root;iso.position.set(x,.22,0);iso.rotation.x=Math.PI/2;iso.material=mats.isolator;iso.isPickable=false;v9.modelVisual.push(iso);});
  }
}
function v9RenderData(){
  const a=v9.records.A,b=v9.records.B,all=[...a,...b],max=Math.max(1,...all.map(r=>r.cycles));
  const exp=v9Experiment(),name={A:exp.a,B:exp.b};
  const rows=['A','B'].map(model=>v9.records[model].map((r,i)=>`<tr><td>${name[model]} ${i+1}</td><td>${r.cycles}</td><td>${r.outcome}</td></tr>`).join('')).join('')||'<tr><td colspan="3">Aún no hay datos: inicia una sacudida.</td></tr>';
  const bars=['A','B'].map(model=>{const values=v9.records[model];const avg=values.length?Math.round(values.reduce((s,r)=>s+r.cycles,0)/values.length):0;return `<div class="lab-bar"><b>${name[model]}</b><span style="width:${avg/max*100}%"></span><em>${avg}</em></div>`;}).join('');
  $('labData').innerHTML=`<table><thead><tr><th>Ensayo</th><th>Ciclos</th><th>Resultado</th></tr></thead><tbody>${rows}</tbody></table><div class="lab-bars">${bars}</div>`;
}
function v9Render(){
  const exp=v9Experiment();
  v9Text('labModelLabel',v9.model==='A'?exp.a:exp.b);v9Text('labCycle',`${v9.cycles} / 30 ciclos`);
  v9Text('labVariable',`AHORA OBSERVAS · ${v9.model==='A'?exp.a:exp.b}`);v9Text('labSceneHint',`En la escena: ${exp.scene}.`);
  v9Text('labModelA',exp.a);v9Text('labModelB',exp.b);
  $('labModelA').classList.toggle('on',v9.model==='A');$('labModelB').classList.toggle('on',v9.model==='B');
  v9Button('labStart',v9.running||!!v9.pending||v9.records[v9.model].length>=3);v9Button('labPause',!v9.running);v9Button('labSave',!v9.pending);
  v9RenderData();
}
function v9ResetTrial(){
  state.gameOver=false;state.hp=100;state.burning=false;state.previewMode='intact';collapseProgress=0;v9.cycles=0;v9.accumulator=0;v9.elapsed=0;v9.pending=null;resetBuildingVisualState();v9ApplyModel();$('collapseBadge').classList.remove('on');
}
function v9Finish(outcome){
  if(!v9.running)return;v9.running=false;state.phase='build';state.paused=false;setPhase('ENSAYO FINALIZADO');v9.pending={cycles:v9.cycles,outcome};v9Text('labPrompt',`${outcome}: registra el dato antes de repetir.`);toast(`${outcome} a los ${v9.cycles} ciclos.`,'warn');v9Render();
}
function v9Start(){
  if(v9.records[v9.model].length>=3)return;v9ResetTrial();v9.running=true;state.phase='wave';setPhase('ENSAYO EN CURSO');v9Text('labPrompt',`Ensayo ${v9.records[v9.model].length+1}: observa el suelo y la parte alta.`);v9Render();
}
function v9Save(){
  if(!v9.pending)return;v9.records[v9.model].push(v9.pending);v9.pending=null;v9Text('labPrompt',v9.records[v9.model].length===3?'Tres datos registrados. Compara el otro modelo.':'Cambia o repite el modelo con las mismas condiciones.');v9Render();
}
function v9Step(dt){
  if(!v9.active){if(v9.groundRoot){v9.groundRoot.position.x=0;v9.groundRoot.rotation.z=0;}return;}
  v9GroundSetup();
  v9AttachTowerToGround();
  const moving=v9.running;const target=moving?Math.sin(time*7.2)*.72:0;
  v9.groundX+=(target-v9.groundX)*(1-Math.exp(-15*dt));v9.groundRoot.position.x=v9.groundX;v9.groundRoot.rotation.z=moving?Math.sin(time*7.2)*.012:0;
  if(!moving)return;
  v9.accumulator+=dt;
  if(v9.accumulator>=.42){
    v9.accumulator-=.42;v9.cycles++;
    applyDamage({intensity:.032+(v9.cycles%5)*.001,type:'fast'});
    if(v9.cycles>=v9Limit())v9Finish('Se inclinó demasiado');
    else if(v9.cycles>=30)v9Finish('Resistió 30 ciclos');
    v9Render();
  }
}
const v9BaseApplyDamage=applyDamage;
applyDamage=function(p){
  if(v9.running&&currentBuilding){const f=currentBuilding.fragility;currentBuilding.fragility=f*v9Experiment().damage[v9ModelIndex()];v9BaseApplyDamage(p);currentBuilding.fragility=f;return;}
  v9BaseApplyDamage(p);
};
const v9BaseUpdateShake=updateShake;
updateShake=function(dt){v9BaseUpdateShake(dt);v9Step(dt);};
const v9BaseFinishGame=finishGame;
finishGame=function(win){if(v9.running){v9Finish('Colapsó');state.gameOver=true;return;}v9BaseFinishGame(win);};

function v9SetMode(lab){
  v9.active=lab;document.body.classList.toggle('v9Lab',lab);$('labPanel').classList.toggle('hidden',!lab);v9Toggle.classList.remove('hidden');$('labModeToggle').textContent=lab?'Exploración libre':'Laboratorio de estabilidad';
  if(lab){$('startModal').style.display='none';v9GroundSetup();v9AttachTowerToGround();v9ResetTrial();v9Render();if(!v9.introSeen)$('labIntro').classList.remove('hidden');}else{v9.running=false;state.phase='build';if(v9.groundRoot){v9.groundRoot.position.x=0;v9.groundRoot.rotation.z=0;}if(currentBuilding)currentBuilding.root.parent=null;}
}
$('labQuestion').addEventListener('change',e=>{v9.question=e.target.value;v9.records={A:[],B:[]};v9ResetTrial();v9Text('labPrompt','Cambia una sola característica y compara tres ensayos.');v9Render();});
$('labModelA').addEventListener('click',()=>{if(!v9.running){v9.model='A';v9ResetTrial();v9Render();}});
$('labModelB').addEventListener('click',()=>{if(!v9.running){v9.model='B';v9ResetTrial();v9Render();}});
$('labStart').addEventListener('click',v9Start);$('labPause').addEventListener('click',()=>{if(v9.running){state.paused=!state.paused;$('labPause').textContent=state.paused?'Continuar':'Pausa';}});$('labSave').addEventListener('click',v9Save);$('labView').addEventListener('click',()=>{$('labData').classList.toggle('hidden');});$('labModeToggle').addEventListener('click',()=>v9SetMode(!v9.active));$('labIntroStart').addEventListener('click',()=>{v9.introSeen=true;$('labIntro').classList.add('hidden');v9Text('labPrompt','Elige una condición y observa qué cambia en la torre antes de iniciar la sacudida.');});$('labIntroSkip').addEventListener('click',()=>{v9.introSeen=true;$('labIntro').classList.add('hidden');});
setTimeout(()=>{const tag=document.querySelector('.brand p');if(tag)tag.textContent='V9 · LABORATORIO DE ESTABILIDAD';const sub=document.querySelector('.brand .sub');if(sub)sub.textContent='Compara una variable, repite tres ensayos y usa datos para concluir.';v9SetMode(true);},0);

// ─────────────────────────────────────────────────────────────────────────────
// V9 LABORATORIO DE ESTABILIDAD
// A controlled, repeatable experiment layer for P02/P03. It keeps the V8
// response engine, but turns its output into comparable classroom evidence.
// ─────────────────────────────────────────────────────────────────────────────
const v9 = {
  active:true, running:false, pending:null, question:'base', model:'A', cycles:0,
  accumulator:0, elapsed:0, records:{A:[],B:[]}, groundRoot:null, modelVisual:[],
  lateral:false, groundX:0
};
const v9Experiments={
  base:{label:'ancho de la base',a:'Base ancha',b:'Base estrecha',limits:[24,12],damage:[.72,1.28]},
  height:{label:'altura de la torre',a:'Torre baja',b:'Torre alta',limits:[25,13],damage:[.74,1.24]},
  brace:{label:'arriostramiento diagonal',a:'Con diagonal',b:'Sin diagonal',limits:[25,14],damage:[.70,1.20]}
};
function v9Experiment(){return v9Experiments[v9.question];}
function v9ModelIndex(){return v9.model==='A'?0:1;}
function v9Limit(){const n=v9.records[v9.model].length;return v9Experiment().limits[v9ModelIndex()]+[0,1,-1][n%3];}
function v9Text(id,text){const el=$(id);if(el)el.textContent=text;}
function v9Button(id,disabled){const el=$(id);if(el)el.disabled=!!disabled;}

const v9Style=document.createElement('style');
v9Style.textContent=`
  #labPanel{position:fixed;z-index:8;left:16px;top:116px;width:min(330px,calc(100vw - 32px));padding:14px;border-radius:16px;background:#081524ed;border:1px solid #ffffff20;box-shadow:0 14px 36px #0008;color:#eef7ff;pointer-events:auto}
  #labPanel h2{margin:0 0 4px;font-size:20px;letter-spacing:-.03em}#labPanel p{margin:0 0 11px;color:#c4d5e2;font-size:12px;line-height:1.35}.lab-row{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:7px 0}.lab-row button,.lab-select{min-height:39px;border:1px solid #ffffff26;border-radius:10px;background:#11243a;color:#eef7ff;padding:8px;font-weight:800;font:inherit;font-size:12px}.lab-row button.on,.lab-row button.primary{background:#79e1d0;color:#062627;border-color:#79e1d0}.lab-row button:disabled{opacity:.42}.lab-select{width:100%;margin:5px 0}.lab-status{display:flex;justify-content:space-between;gap:8px;margin:10px 0;padding:9px 10px;border-radius:10px;background:#ffffff0d;font-size:12px}.lab-status strong{color:#f6cb73}.lab-data{max-height:180px;overflow:auto;margin-top:9px;font-size:11px}.lab-data table{width:100%;border-collapse:collapse}.lab-data th,.lab-data td{padding:5px;border-bottom:1px solid #ffffff14;text-align:left}.lab-bars{display:grid;gap:5px;margin-top:8px}.lab-bar{display:grid;grid-template-columns:68px 1fr 26px;gap:6px;align-items:center}.lab-bar span{height:8px;background:#79e1d0;border-radius:4px}.lab-note{margin-top:9px;color:#b9cada;font-size:10px;line-height:1.3}.lab-toggle{position:fixed;z-index:9;right:16px;bottom:16px;pointer-events:auto}.lab-toggle button{border:1px solid #ffffff2b;border-radius:12px;background:#0b1728ed;color:#eef7ff;padding:10px 12px;font-weight:900}.v9Lab .left,.v9Lab .quickInfo,.v9Lab .alarmBadge,.v9Lab .fireBadge,.v9Lab #quickStart{display:none!important}.v9Lab .brand .sub{max-width:310px}.v9Lab .pills{max-width:52vw}.v9Lab #warning{max-width:460px;margin-left:auto;margin-right:auto}@media(max-width:760px){#labPanel{top:auto;bottom:16px;max-height:60vh;overflow:auto}.v9Lab .pills{display:none}.v9Lab .brand h1{font-size:26px}}
`;
document.head.appendChild(v9Style);

const v9Panel=document.createElement('section');
v9Panel.id='labPanel';
v9Panel.innerHTML=`<h2>Laboratorio de estabilidad</h2><p id="labPrompt">Cambia una sola característica y compara tres ensayos.</p><select id="labQuestion" class="lab-select" aria-label="Característica a investigar"><option value="base">Base: ancha / estrecha</option><option value="height">Altura: baja / alta</option><option value="brace">Diagonal: con / sin</option></select><div class="lab-row"><button id="labModelA" class="on">Modelo A</button><button id="labModelB">Modelo B</button></div><div class="lab-status"><span id="labModelLabel">Base ancha</span><strong id="labCycle">0 / 30 ciclos</strong></div><div class="lab-row"><button id="labStart" class="primary">Iniciar ensayo</button><button id="labPause">Pausa</button></div><div class="lab-row"><button id="labSave" disabled>Registrar resultado</button><button id="labView">Ver datos</button></div><div id="labData" class="lab-data hidden"></div><div class="lab-note">Controlados: suelo, amplitud, ritmo, material y duración. El modelo compara torres; no predice edificios reales.</div>`;
document.body.appendChild(v9Panel);
const v9Toggle=document.createElement('div');
v9Toggle.className='lab-toggle';
v9Toggle.innerHTML='<button id="labModeToggle">Exploración libre</button>';
document.body.appendChild(v9Toggle);

function v9GroundSetup(){
  if(v9.groundRoot)return;
  v9.groundRoot=new B.TransformNode('v9GroundRoot',scene);
  const meshNames=/^(ground|lot|road|road2|safe|safe2|line|bar)/;
  scene.meshes.filter(m=>meshNames.test(m.name)).forEach(m=>m.parent=v9.groundRoot);
  scene.transformNodes.filter(n=>/^(fenceRoot|car\d+)/.test(n.name)).forEach(n=>n.parent=v9.groundRoot);
}
function v9AttachTowerToGround(){
  if(currentBuilding && v9.groundRoot && currentBuilding.root.parent!==v9.groundRoot)currentBuilding.root.parent=v9.groundRoot;
}
function v9ClearVisual(){v9.modelVisual.forEach(m=>{if(!m.isDisposed?.())m.dispose();});v9.modelVisual=[];}
function v9ApplyModel(){
  if(!currentBuilding)return;v9ClearVisual();
  const exp=v9Experiment(), idx=v9ModelIndex(), root=currentBuilding.root;
  root.scaling.y=v9.question==='height'?(idx===0?.74:1.14):1;
  if(v9.question==='base'){
    const plate=B.MeshBuilder.CreateBox('v9Base',{width:idx===0?11.6:6.8,height:.28,depth:idx===0?8.8:5.6},scene);
    plate.parent=root;plate.position.set(0,.14,0);plate.material=mats.concrete;plate.isPickable=false;v9.modelVisual.push(plate);
  }
  if(v9.question==='brace'&&idx===0){
    [-1,1].forEach(side=>{const brace=B.MeshBuilder.CreateBox('v9Brace',{width:.16,height:14,depth:.14},scene);brace.parent=root;brace.position.set(side*2.6,7,3.55);brace.rotation.z=side*.38;brace.material=mats.rail;brace.isPickable=false;v9.modelVisual.push(brace);});
  }
}
function v9RenderData(){
  const a=v9.records.A,b=v9.records.B,all=[...a,...b],max=Math.max(1,...all.map(r=>r.cycles));
  const rows=['A','B'].map(model=>v9.records[model].map((r,i)=>`<tr><td>${model}${i+1}</td><td>${r.cycles}</td><td>${r.outcome}</td></tr>`).join('')).join('')||'<tr><td colspan="3">Aún no hay ensayos.</td></tr>';
  const bars=['A','B'].map(model=>{const values=v9.records[model];const avg=values.length?Math.round(values.reduce((s,r)=>s+r.cycles,0)/values.length):0;return `<div class="lab-bar"><b>${model}: ${avg}</b><span style="width:${avg/max*100}%"></span><em>${avg}</em></div>`;}).join('');
  $('labData').innerHTML=`<table><thead><tr><th>Ensayo</th><th>Ciclos</th><th>Resultado</th></tr></thead><tbody>${rows}</tbody></table><div class="lab-bars">${bars}</div>`;
}
function v9Render(){
  const exp=v9Experiment();
  v9Text('labModelLabel',v9.model==='A'?exp.a:exp.b);v9Text('labCycle',`${v9.cycles} / 30 ciclos`);
  $('labModelA').classList.toggle('on',v9.model==='A');$('labModelB').classList.toggle('on',v9.model==='B');
  v9Button('labStart',v9.running||!!v9.pending||v9.records[v9.model].length>=3);v9Button('labPause',!v9.running);v9Button('labSave',!v9.pending);
  v9RenderData();
}
function v9ResetTrial(){
  state.gameOver=false;state.hp=100;state.burning=false;state.previewMode='intact';collapseProgress=0;v9.cycles=0;v9.accumulator=0;v9.elapsed=0;v9.pending=null;resetBuildingVisualState();v9ApplyModel();$('collapseBadge').classList.remove('on');
}
function v9Finish(outcome){
  if(!v9.running)return;v9.running=false;state.phase='build';state.paused=false;setPhase('ENSAYO FINALIZADO');v9.pending={cycles:v9.cycles,outcome};v9Text('labPrompt',`${outcome}: registra el dato antes de repetir.`);toast(`${outcome} a los ${v9.cycles} ciclos.`,'warn');v9Render();
}
function v9Start(){
  if(v9.records[v9.model].length>=3)return;v9ResetTrial();v9.running=true;state.phase='wave';setPhase('ENSAYO EN CURSO');v9Text('labPrompt',`Ensayo ${v9.records[v9.model].length+1}: observa el suelo y la parte alta.`);v9Render();
}
function v9Save(){
  if(!v9.pending)return;v9.records[v9.model].push(v9.pending);v9.pending=null;v9Text('labPrompt',v9.records[v9.model].length===3?'Tres datos registrados. Compara el otro modelo.':'Cambia o repite el modelo con las mismas condiciones.');v9Render();
}
function v9Step(dt){
  if(!v9.active){if(v9.groundRoot)v9.groundRoot.position.x=0;return;}
  v9GroundSetup();
  v9AttachTowerToGround();
  const moving=v9.running;const target=moving?Math.sin(time*7.2)*.34:0;
  v9.groundX+=(target-v9.groundX)*(1-Math.exp(-12*dt));v9.groundRoot.position.x=v9.groundX;
  if(!moving)return;
  v9.accumulator+=dt;
  if(v9.accumulator>=.42){
    v9.accumulator-=.42;v9.cycles++;
    applyDamage({intensity:.032+(v9.cycles%5)*.001,type:'fast'});
    if(v9.cycles>=v9Limit())v9Finish('Se inclinó demasiado');
    else if(v9.cycles>=30)v9Finish('Resistió 30 ciclos');
    v9Render();
  }
}
const v9BaseApplyDamage=applyDamage;
applyDamage=function(p){
  if(v9.running&&currentBuilding){const f=currentBuilding.fragility;currentBuilding.fragility=f*v9Experiment().damage[v9ModelIndex()];v9BaseApplyDamage(p);currentBuilding.fragility=f;return;}
  v9BaseApplyDamage(p);
};
const v9BaseUpdateShake=updateShake;
updateShake=function(dt){v9BaseUpdateShake(dt);v9Step(dt);};
const v9BaseFinishGame=finishGame;
finishGame=function(win){if(v9.running){v9Finish('Colapsó');state.gameOver=true;return;}v9BaseFinishGame(win);};

function v9SetMode(lab){
  v9.active=lab;document.body.classList.toggle('v9Lab',lab);$('labPanel').classList.toggle('hidden',!lab);v9Toggle.classList.remove('hidden');$('labModeToggle').textContent=lab?'Exploración libre':'Laboratorio de estabilidad';
  if(lab){$('startModal').style.display='none';v9GroundSetup();v9AttachTowerToGround();v9ResetTrial();v9Render();}else{v9.running=false;state.phase='build';if(v9.groundRoot)v9.groundRoot.position.x=0;if(currentBuilding)currentBuilding.root.parent=null;}
}
$('labQuestion').addEventListener('change',e=>{v9.question=e.target.value;v9.records={A:[],B:[]};v9ResetTrial();v9Text('labPrompt','Cambia una sola característica y compara tres ensayos.');v9Render();});
$('labModelA').addEventListener('click',()=>{if(!v9.running){v9.model='A';v9ResetTrial();v9Render();}});
$('labModelB').addEventListener('click',()=>{if(!v9.running){v9.model='B';v9ResetTrial();v9Render();}});
$('labStart').addEventListener('click',v9Start);$('labPause').addEventListener('click',()=>{if(v9.running){state.paused=!state.paused;$('labPause').textContent=state.paused?'Continuar':'Pausa';}});$('labSave').addEventListener('click',v9Save);$('labView').addEventListener('click',()=>{$('labData').classList.toggle('hidden');});$('labModeToggle').addEventListener('click',()=>v9SetMode(!v9.active));
setTimeout(()=>{const tag=document.querySelector('.brand p');if(tag)tag.textContent='V9 · LABORATORIO DE ESTABILIDAD';const sub=document.querySelector('.brand .sub');if(sub)sub.textContent='Compara una variable, repite tres ensayos y usa datos para concluir.';v9SetMode(true);},0);
